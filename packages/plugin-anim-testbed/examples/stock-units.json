// A testbed spec with stock units and stock sounds only, so it copies no files. It builds on the example
// Campaign's Mission: copy it to missions/ashfall-relay/tests/ in a Workspace made by init, compile the
// Mission once (npm run compile-map -- missions/ashfall-relay/blueprint.json), then run the testbed on it.
{
  "name": "StockUnits",
  "title": "Stock units",
  "base": "../Ashfall-Relay.SC2Map",
  "out": "../output/StockUnits.SC2Map",
  // The open ground of the Mission's Ash Flats.
  "stage": { "at": [36, 22], "gap": 4, "facing": 270 },
  "target": { "unit": "Zergling", "player": 1 },
  // The moments, in dropdown order. Each unit's variations of a moment are whole timelines: elements at
  // seconds from Play. The impacts play on the target, at the attack animation's land.
  "moments": ["attack", "impact", "death", "voice"],
  "units": [
    {
      "key": "marine",
      "unit": "Marine",
      "reach": 3,
      "animations": {
        "attack": { "play": "AnimPlay Attack Attack NonLooping", "strike": 0.1, "land": 0.15 }
      },
      "moments": {
        "attack": {
          "variations": [
            {
              "elements": [
                { "anim": "attack", "at": 0 },
                { "sound": "Marine_AttackLaunch", "at": 0.1 }
              ],
              "note": "the Marine's own rifle burst", "pick": true
            },
            {
              "elements": [
                { "anim": "attack", "at": 0 },
                { "sound": "Marine_Stimpack", "at": 0, "stop": 0.6 },
                { "sound": "Marine_AttackLaunch", "at": 0.15 }
              ],
              "note": "a stim grunt, cut off at 0.6 s, then the burst"
            }
          ]
        },
        "impact": {
          "variations": [
            {
              "elements": [
                { "anim": "attack", "at": 0 },
                { "sound": "Marine_AttackImpact", "at": 0.15, "on": "target" }
              ],
              "note": "the Marine's own bullet hits", "pick": true
            },
            {
              "elements": [
                { "anim": "attack", "at": 0 },
                { "sound": "Protoss_ShieldImpact", "at": 0.15, "on": "target" },
                { "sound": "Marine_AttackImpact", "at": 0.18, "on": "target" }
              ],
              "note": "a shield hit layered over the bullet hits"
            }
          ]
        },
        "death": {
          "variations": [
            {
              "elements": [
                { "kill": true, "at": 0 },
                { "sound": "Marine_Death", "at": 0 }
              ],
              "note": "the Marine's own death", "pick": true
            },
            {
              "elements": [
                { "kill": true, "at": 0 },
                { "sound": "Marine_Death", "at": 0 },
                { "sound": "Marine_Death_BodyFall_A", "at": 1 }
              ],
              "note": "the death and a body fall as he lands"
            },
            {
              "elements": [
                { "kill": true, "at": 0 },
                { "sound": "Marine_DeathFXEviscerate", "at": 0 }
              ],
              "note": "the eviscerate death sound"
            }
          ]
        },
        "voice": {
          "variations": [
            {
              "elements": [
                { "sound": "Marine_Yes", "at": 0 }
              ],
              "note": "his Yes responses", "pick": true
            },
            {
              "elements": [
                { "sound": "Marine_What", "at": 0 }
              ],
              "note": "his What responses"
            },
            {
              "elements": [
                { "sound": "Marine_Pissed", "at": 0 }
              ],
              "note": "his Pissed responses"
            }
          ]
        }
      }
    },
    {
      "key": "zealot",
      "unit": "Zealot",
      "reach": 1.2,
      "animations": {
        "attack": { "play": "AnimPlay Attack Attack NonLooping", "strike": 0.25, "land": 0.3 }
      },
      "moments": {
        "attack": {
          "variations": [
            {
              "elements": [
                { "anim": "attack", "at": 0 },
                { "sound": "Zealot_AttackLaunch", "at": 0.25 }
              ],
              "note": "the Zealot's own blade swing", "pick": true
            },
            {
              "elements": [
                { "anim": "attack", "at": 0 },
                { "sound": "Zealot_Charge", "at": 0 },
                { "sound": "Zealot_AttackLaunch", "at": 0.25 }
              ],
              "note": "the charge cry before the swing"
            }
          ]
        },
        "impact": {
          "variations": [
            {
              "elements": [
                { "anim": "attack", "at": 0 },
                { "sound": "Zealot_AttackImpact", "at": 0.3, "on": "target" }
              ],
              "note": "the Zealot's own blade hit", "pick": true
            },
            {
              "elements": [
                { "anim": "attack", "at": 0 },
                { "sound": "Protoss_AttackImpactMediumSlice", "at": 0.3, "on": "target" }
              ],
              "note": "a medium Protoss slice"
            }
          ]
        },
        "death": {
          "variations": [
            {
              "elements": [
                { "kill": true, "at": 0 },
                { "sound": "Zealot_Death", "at": 0 }
              ],
              "note": "the Zealot's own death", "pick": true
            }
          ]
        },
        "voice": {
          "variations": [
            {
              "elements": [
                { "sound": "Zealot_Yes", "at": 0 }
              ],
              "note": "his Yes responses", "pick": true
            },
            {
              "elements": [
                { "sound": "Zealot_Ready", "at": 0 }
              ],
              "note": "his Ready response"
            }
          ]
        }
      }
    },
    {
      "key": "marauder",
      "unit": "Marauder",
      "reach": 3,
      "respawn": 3,
      "animations": {
        "attack": { "play": "AnimPlay Attack Attack NonLooping", "strike": 0.2, "land": 0.6 }
      },
      "moments": {
        "attack": {
          "variations": [
            {
              "elements": [
                { "anim": "attack", "at": 0 },
                { "sound": "Marauder_AttackLaunch", "at": 0.2 }
              ],
              "note": "the Marauder's own grenade launch", "pick": true
            }
          ]
        },
        "impact": {
          "variations": [
            {
              "elements": [
                { "anim": "attack", "at": 0 },
                { "sound": "Marauder_AttackImpact", "at": 0.6, "on": "target" }
              ],
              "note": "the grenade landing, 0.4 s after the launch", "pick": true
            }
          ]
        },
        "death": {
          "variations": [
            {
              "elements": [
                { "kill": true, "at": 0 },
                { "sound": "Marauder_Death", "at": 0 }
              ],
              "note": "the Marauder's own death", "pick": true
            },
            {
              "elements": [
                { "kill": true, "at": 0 },
                { "sound": "Marauder_Death", "at": 0 },
                { "sound": "Marine_Death_BodyFall_B", "at": 0.9 }
              ],
              "note": "the death and a body fall"
            }
          ]
        },
        "voice": {
          "variations": [
            {
              "elements": [
                { "sound": "Marauder_Yes", "at": 0 }
              ],
              "note": "his Yes responses", "pick": true
            }
          ]
        }
      }
    }
  ],
  // What a --capture build films: each stop's state, played, then a frame after its hold.
  "tour": [
    { "unit": "marine", "moment": "attack", "variation": 2, "hold": 0.5 },
    { "unit": "zealot", "moment": "impact", "hold": 0.6 },
    { "unit": "marauder", "moment": "death", "variation": 2, "hold": 1.2 },
    { "unit": "marine", "moment": "voice", "hold": 0.4 }
  ]
}
