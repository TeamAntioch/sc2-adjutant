//==================================================================================================
// Animation and sound testbed: the runtime. The build (build.ts) puts the spec's constants at the
// CONSTANTS marker line and its Tb_Data() at the DATA marker line, then writes the whole file into
// the map (Triggers and MapScript.galaxy). Nothing here is specific to one test.
//
// The tables: units (each with animations), moments (each with a do, an at and a from), each unit's
// animation for each moment, variations per unit and moment (a flat list, tb_v0/tb_vN index it), and
// cues per variation (a flat list, tb_vQ0/tb_vQN index it). A cue is a sound, an actor message or an
// effect at a time; a time is a base (the animation's start, strike or land) plus an offset, so a
// candidate follows whichever animation is selected.
//
// Lessons built in: dialog events are registered one type at a time with c_invalidDialogControlId
// (Any never fires); pulldown items count from 1; a new unit's actor needs 0.5 s before it takes
// messages; sounds on a dead unit are dropped, so a kill's sounds play at the point it died.
//==================================================================================================

//@@CONSTANTS

// What a moment's Play does to the selected unit
const int TB_DO_NONE = 0;        // nothing: the cues alone
const int TB_DO_PLAY = 1;        // the selected animation
const int TB_DO_KILL = 2;        // kill it; its sounds play at the point it died, and it respawns

// Where a moment's sounds play
const int TB_AT_UNIT = 0;
const int TB_AT_TARGET = 1;      // the point in front of the unit when there is no target

const int TB_CUE_SOUND = 0;
const int TB_CUE_ACTOR = 1;      // an actor message to the unit (or a child actor in its scope)
const int TB_CUE_TARGET = 2;     // an actor message to the target
const int TB_CUE_EFFECT = 3;     // a CEffect from the unit, at the target (or the point in front of it)

const int TB_BASE_START = 0;
const int TB_BASE_STRIKE = 1;
const int TB_BASE_LAND = 2;

const fixed TB_TARGET_RESPAWN = 2.0;  // how long after an effect kills the target it comes back
const int TB_DLG_H = 745;             // the dialog's height
const fixed TB_STEP = 0.05;           // a strike or land stepper press (a cue's Wait resolves to a game loop, 1/16 s)
const string TB_GOLD = "d8b45a";      // a marker row, and a tuned value

// Units
string[TB_NU] tb_uName;
string[TB_NU] tb_uType;
fixed[TB_NU] tb_uReach;
string[TB_NU] tb_uIdle;
fixed[TB_NU] tb_uRespawn;
int[TB_NU] tb_uNAnim;
unit[TB_NU] tb_unit;

// Animations
string[TB_NU][TB_NA] tb_aName;
string[TB_NU][TB_NA] tb_aPlay;
fixed[TB_NU][TB_NA] tb_aStrike;
fixed[TB_NU][TB_NA] tb_aLand;
fixed[TB_NU][TB_NA] tb_aLen;
fixed[TB_NU][TB_NA] tb_aClear;   // 0: let it finish
// What the build gave each animation, so a tuned one shows (gold) and the bank records both
fixed[TB_NU][TB_NA] tb_aStrike0;
fixed[TB_NU][TB_NA] tb_aLand0;
fixed[TB_NU][TB_NA] tb_aLen0;
bool[TB_NU][TB_NA] tb_aLink;     // land follows strike: the spec left land out, and it hasn't been stepped
string[TB_NU][TB_NA] tb_aSec;    // its section in the tuning bank

// Moments, and each unit's animation for each
string[TB_NM] tb_mName;
int[TB_NM] tb_mDo;
int[TB_NM] tb_mAt;
int[TB_NM] tb_mFrom;             // the base of a cue's plain seconds (the build has applied it)
int[TB_NU][TB_NM] tb_umAnim;

// Variations
int[TB_NU][TB_NM] tb_v0;
int[TB_NU][TB_NM] tb_vN;
string[TB_NV] tb_vLabel;
string[TB_NV] tb_vNote;
bool[TB_NV] tb_vPick;
int[TB_NV] tb_vAnim;             // -1: the moment's
int[TB_NV] tb_vQ0;
int[TB_NV] tb_vQN;
int tb_nv = 0;

// Cues
int[TB_NQ] tb_qKind;
string[TB_NQ] tb_qText;
string[TB_NQ] tb_qChild;
int[TB_NQ] tb_qBase;
fixed[TB_NQ] tb_qAt;
int[TB_NQ] tb_qStopBase;         // -1: let it play out
fixed[TB_NQ] tb_qStop;
int tb_nq = 0;

// The tour (a --capture build): each stop selects a unit, moment, animation and variation, plays
// it, and announces itself in a bank after its hold, for the Host to screenshot.
int[TB_NTOUR] tb_tU;
int[TB_NTOUR] tb_tM;
int[TB_NTOUR] tb_tA;             // -1: the variation's or the moment's
int[TB_NTOUR] tb_tV;             // -1: none
fixed[TB_NTOUR] tb_tHold;
int tb_ntour = 0;

// Selection and playback
int tb_cur = 0;
int tb_mom = 0;
int tb_var = 0;                  // within the unit and moment's variations, from 0; tb_vN: "(none)"
int tb_anim = 0;                 // the selected animation of the selected unit
int tb_gen = 0;                  // Stop and each Play bump it; a running timeline quits when it changes
bool tb_looping = false;
fixed tb_lastEnd = 0.0;          // how long the last Play's action lasts (animation length, respawn), for Loop
fixed tb_lastRan = 0.0;          // how far the last Play waited through it
unit tb_target;

// The GUI
int tb_dlg;
bank tb_bank;                    // the tuning bank, TB_TUNE_BANK: never cleared here, only by --apply
int tb_unitPd;
int tb_momPd;
int tb_varPd;
int tb_note;
int tb_animLabel;
int tb_animPd;
int tb_sLabel;                   // the stepper row: Strike [-] 0.10 [+]   Land [-] 0.10 [+]  = strike
int tb_sDown;
int tb_sVal;
int tb_sUp;
int tb_lLabel;
int tb_lDown;
int tb_lVal;
int tb_lUp;
int tb_lLink;
int tb_play;
int tb_stop;
int tb_loop;
int tb_read;
int tb_edit;
int tb_send;

// The readout: its sentence, then its rows in time order (cues, and strike and land markers)
string tb_head = "";
string[TB_NT] tb_row;
fixed[TB_NT] tb_rowT;
bool[TB_NT] tb_rowMark;
bool[TB_NT] tb_fired;
int tb_nrow = 0;
fixed tb_clock = 0.0;

//--------------------------------------------------------------------------------------------------
// Filling the tables (Tb_Data calls these)
//--------------------------------------------------------------------------------------------------

void Tb_U (int u, string name, string type, fixed reach, string idle, fixed respawn) {
    tb_uName[u] = name;
    tb_uType[u] = type;
    tb_uReach[u] = reach;
    tb_uIdle[u] = idle;
    tb_uRespawn[u] = respawn;
}

// linked: the spec leaves land out, so it follows the strike. sec: its section in the tuning bank.
void Tb_A (int u, int a, string name, string play, fixed strike, fixed land, fixed len, fixed clear, bool linked, string sec) {
    tb_aName[u][a] = name;
    tb_aPlay[u][a] = play;
    tb_aStrike[u][a] = strike;
    tb_aLand[u][a] = land;
    tb_aLen[u][a] = len;
    tb_aClear[u][a] = clear;
    tb_aStrike0[u][a] = strike;
    tb_aLand0[u][a] = land;
    tb_aLen0[u][a] = len;
    tb_aLink[u][a] = linked;
    tb_aSec[u][a] = sec;
    if (tb_uNAnim[u] < a + 1) { tb_uNAnim[u] = a + 1; }
}

void Tb_M (int m, string name, int doIt, int at, int from) {
    tb_mName[m] = name;
    tb_mDo[m] = doIt;
    tb_mAt[m] = at;
    tb_mFrom[m] = from;
}

void Tb_UM (int u, int m, int a) {
    tb_umAnim[u][m] = a;
}

// A variation for unit u in moment m; the cues added next (Tb_Q) are its own. Each unit and
// moment's variations come together.
void Tb_V (int u, int m, string label, string note, bool pick, int a) {
    if (tb_vN[u][m] == 0) { tb_v0[u][m] = tb_nv; }
    tb_vN[u][m] += 1;
    tb_vLabel[tb_nv] = label;
    tb_vNote[tb_nv] = note;
    tb_vPick[tb_nv] = pick;
    tb_vAnim[tb_nv] = a;
    tb_vQ0[tb_nv] = tb_nq;
    tb_vQN[tb_nv] = 0;
    tb_nv += 1;
}

void Tb_Q (int kind, string what, string child, int base, fixed at, int stopBase, fixed stop) {
    tb_qKind[tb_nq] = kind;
    tb_qText[tb_nq] = what;
    tb_qChild[tb_nq] = child;
    tb_qBase[tb_nq] = base;
    tb_qAt[tb_nq] = at;
    tb_qStopBase[tb_nq] = stopBase;
    tb_qStop[tb_nq] = stop;
    tb_vQN[tb_nv - 1] += 1;
    tb_nq += 1;
}

void Tb_T (int u, int m, int a, int v, fixed hold) {
    tb_tU[tb_ntour] = u;
    tb_tM[tb_ntour] = m;
    tb_tA[tb_ntour] = a;
    tb_tV[tb_ntour] = v;
    tb_tHold[tb_ntour] = hold;
    tb_ntour += 1;
}

//@@DATA

//--------------------------------------------------------------------------------------------------
// Helpers
//--------------------------------------------------------------------------------------------------

void Tb_Msg (string s) {
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, StringToText(s));
}

actor Tb_Actor (unit u) {
    return ActorFromScope(ActorScopeFromUnit(u), "::Main");
}

void Tb_Text (int c, string s) {
    DialogControlSetPropertyAsText(c, c_triggerControlPropertyText, PlayerGroupAll(), StringToText(s));
}

string Tb_F (fixed f) {
    return FixedToString(f, 2);
}

point Tb_Home (int u) {
    return Point(TB_X + TB_GAP * IntToFixed(u), TB_Y);
}

// Where the target stands for unit u: reach cells in front of it.
point Tb_Front (int u) {
    return PointWithOffsetPolar(Tb_Home(u), tb_uReach[u], TB_FACING);
}

bool Tb_Plays () {
    return tb_mDo[tb_mom] == TB_DO_PLAY;
}

// The selected variation's index in the flat list, or -1 for "(none)".
int Tb_VarIndex () {
    if (tb_var >= tb_vN[tb_cur][tb_mom]) { return -1; }
    return tb_v0[tb_cur][tb_mom] + tb_var;
}

// The animation the selection plays: the variation's, else the unit's for the moment.
int Tb_AnimFor (int v) {
    if (v >= 0 && tb_vAnim[v] >= 0) { return tb_vAnim[v]; }
    return tb_umAnim[tb_cur][tb_mom];
}

fixed Tb_BaseTime (int base) {
    if (tb_uNAnim[tb_cur] == 0) { return 0.0; }
    if (base == TB_BASE_STRIKE) { return tb_aStrike[tb_cur][tb_anim]; }
    if (base == TB_BASE_LAND) { return tb_aLand[tb_cur][tb_anim]; }
    return 0.0;
}

void Tb_Spawn (int u) {
    UnitCreate(1, tb_uType[u], c_unitCreateIgnorePlacement, TB_PLAYER, Tb_Home(u), TB_FACING);
    tb_unit[u] = UnitLastCreated();
    UnitSetState(tb_unit[u], c_unitStateInvulnerable, true);
    UnitSetPropertyFixed(tb_unit[u], c_unitPropMovementSpeed, 0.0);
}

void Tb_Idle (int u) {
    if (tb_uIdle[u] != "") { ActorSend(Tb_Actor(tb_unit[u]), tb_uIdle[u]); }
}

// Frames unit u and its target to the right of the dialog, closer than the default camera (the tour).
void Tb_Focus (int u) {
    point p = PointWithOffsetPolar(Tb_Home(u), tb_uReach[u] / 2.0, TB_FACING);
    CameraPan(1, Point(PointGetX(p) - TB_CAM_SHIFT, PointGetY(p)), 0.0, -1, 0.0, false);
    CameraSetValue(1, c_cameraValueDistance, TB_CAM_DISTANCE, 0.0, -1, 0.0);
}

void Tb_PlaceTarget () {
    if (tb_target == null || !UnitIsAlive(tb_target)) { return; }
    UnitSetPosition(tb_target, Tb_Front(tb_cur), false);
    UnitSetFacing(tb_target, TB_FACING + 180.0, 0.0);
}

//--------------------------------------------------------------------------------------------------
// The readout
//--------------------------------------------------------------------------------------------------

void Tb_ShowRead () {
    string s = tb_head + "<n/>t = " + Tb_F(tb_clock);
    int i;
    for (i = 0; i < tb_nrow; i += 1) {
        if (tb_rowMark[i]) { s = s + "<n/><c val=\"" + TB_GOLD + "\">" + tb_row[i] + "</c>"; }
        else if (tb_fired[i]) { s = s + "<n/>" + tb_row[i]; }
        else { s = s + "<n/><c val=\"8a8a8a\">" + tb_row[i] + "</c>"; }
    }
    Tb_Text(tb_read, s);
}

// Adds a row at time t, keeping the rows in time order (a marker before a cue at the same time).
void Tb_AddRow (fixed t, string line, bool mark) {
    int i = tb_nrow;
    if (tb_nrow >= TB_NT) { return; }
    while (i > 0) {
        // Stop at the first earlier row (or a row at the same time, unless this marker goes before a cue there).
        if (tb_rowT[i - 1] < t) { break; }
        if (tb_rowT[i - 1] == t && !(mark && !tb_rowMark[i - 1])) { break; }
        tb_row[i] = tb_row[i - 1];
        tb_rowT[i] = tb_rowT[i - 1];
        tb_rowMark[i] = tb_rowMark[i - 1];
        tb_fired[i] = tb_fired[i - 1];
        i -= 1;
    }
    tb_row[i] = line;
    tb_rowT[i] = t;
    tb_rowMark[i] = mark;
    tb_fired[i] = false;
    tb_nrow += 1;
}

// Marks the first unfired cue row at time t with this line as fired.
void Tb_FireRow (fixed t, string line) {
    int i;
    for (i = 0; i < tb_nrow; i += 1) {
        if (!tb_rowMark[i] && !tb_fired[i] && tb_rowT[i] == t && tb_row[i] == line) {
            tb_fired[i] = true;
            return;
        }
    }
}

// A cue's row in the readout: its time, what it is, and its fade.
string Tb_CueText (int q, fixed t) {
    string s = Tb_F(t) + "  ";
    if (tb_qKind[q] == TB_CUE_SOUND) { s = s + "sound  " + tb_qText[q]; }
    else if (tb_qKind[q] == TB_CUE_EFFECT) { s = s + "effect  " + tb_qText[q]; }
    else if (tb_qKind[q] == TB_CUE_TARGET) { s = s + "target  " + tb_qText[q]; }
    else if (tb_qChild[q] != "") { s = s + "actor  [" + tb_qChild[q] + "] " + tb_qText[q]; }
    else { s = s + "actor  " + tb_qText[q]; }
    if (tb_qStopBase[q] >= 0) { s = s + "  (fades at " + Tb_F(Tb_BaseTime(tb_qStopBase[q]) + tb_qStop[q]) + ")"; }
    return s;
}

// The selection in one sentence: what the moment does and where its sounds play.
void Tb_Head () {
    int m = tb_mom;
    int u = tb_cur;
    int a = tb_anim;
    string at = "at the unit";
    string from = "";
    if (tb_mAt[m] == TB_AT_TARGET && tb_target != null) { at = "at the target"; }
    else if (tb_mAt[m] == TB_AT_TARGET) { at = "at the point in front"; }
    else if (tb_mDo[m] == TB_DO_KILL) { at = "where it died"; }
    if (tb_mFrom[m] == TB_BASE_STRIKE) { from = ", times from the strike"; }
    else if (tb_mFrom[m] == TB_BASE_LAND) { from = ", times from the land"; }
    tb_head = tb_uName[u] + " " + tb_mName[m] + ": ";
    if (tb_mDo[m] == TB_DO_PLAY && tb_uNAnim[u] > 0) {
        tb_head = tb_head + "animation " + tb_aName[u][a] + " (" + Tb_F(tb_aLen[u][a]) + " s)";
    }
    else if (tb_mDo[m] == TB_DO_PLAY) { tb_head = tb_head + "no animation to play"; }
    else if (tb_mDo[m] == TB_DO_KILL) { tb_head = tb_head + "killed, back after " + Tb_F(tb_uRespawn[u]) + " s"; }
    else { tb_head = tb_head + "the cues alone"; }
    tb_head = tb_head + ". Sounds " + at + from + ".";
}

void Tb_Note () {
    int v = Tb_VarIndex();
    if (v >= 0) { Tb_Text(tb_note, tb_vNote[v]); }
    else { Tb_Text(tb_note, "(none: Play does the moment's action alone)"); }
}

// The variation's cue rows, and the animation's strike and land markers, in time order.
void Tb_Rows (int v) {
    int q;
    int i;
    fixed t;
    tb_nrow = 0;
    if (Tb_Plays() && tb_uNAnim[tb_cur] > 0) {
        Tb_AddRow(tb_aStrike[tb_cur][tb_anim], Tb_F(tb_aStrike[tb_cur][tb_anim]) + "  --- strike ---", true);
        Tb_AddRow(tb_aLand[tb_cur][tb_anim], Tb_F(tb_aLand[tb_cur][tb_anim]) + "  --- land ---", true);
    }
    if (v < 0) { return; }
    for (i = 0; i < tb_vQN[v]; i += 1) {
        q = tb_vQ0[v] + i;
        t = Tb_BaseTime(tb_qBase[q]) + tb_qAt[q];
        Tb_AddRow(t, Tb_CueText(q, t), false);
    }
}

void Tb_ReadReset () {
    tb_clock = 0.0;
    Tb_Head();
    Tb_Note();
    Tb_Rows(Tb_VarIndex());
    Tb_ShowRead();
}

//--------------------------------------------------------------------------------------------------
// Playing
//--------------------------------------------------------------------------------------------------

void Tb_Sound (string id, unit on, point at, bool atPoint) {
    if (atPoint) {
        SoundPlayAtPointForPlayer(SoundLink(id, c_soundIndexAny), c_maxPlayers, PlayerGroupAll(), at, 1.0, 100.0, 0.0);
    }
    else {
        SoundPlayOnUnitForPlayer(SoundLink(id, c_soundIndexAny), c_maxPlayers, PlayerGroupAll(), on, 0.0, 100.0, 0.0);
    }
}

// A CEffect from the selected unit at the target, or at the point in front of it; from the unit's
// player at that point when the unit is dead (a kill moment).
void Tb_Effect (string id) {
    unit u = tb_unit[tb_cur];
    if (!UnitIsAlive(u)) { PlayerCreateEffectPoint(TB_PLAYER, id, Tb_Front(tb_cur)); }
    else if (tb_target != null && UnitIsAlive(tb_target)) { UnitCreateEffectUnit(u, id, tb_target); }
    else { UnitCreateEffectPoint(u, id, Tb_Front(tb_cur)); }
}

void Tb_ActorCue (actor a, string child, string msg) {
    if (child == "") { ActorSend(a, msg); }
    else { ActorSend(ActorFromScope(ActorScopeFromActor(a), child), msg); }
}

// Runs variation v's cues in time order from now. Sounds play on `on` (or at `at` when atPoint);
// actor cues go to ua (the unit's actor, taken before any kill) or ta (the target's). Returns the
// time it ran to; quits early if tb_gen changes (Stop, or another Play).
fixed Tb_RunCues (int v, int gen, unit on, point at, bool atPoint, actor ua, actor ta) {
    fixed[TB_NT] t;
    fixed[TB_NT] stop;
    bool[TB_NT] played;
    bool[TB_NT] stopped;
    sound[TB_NT] snd;
    int n = tb_vQN[v];
    int q0 = tb_vQ0[v];
    int q;
    int i;
    int best;
    bool isStop;
    fixed when = 0.0;
    fixed now = 0.0;
    for (i = 0; i < n; i += 1) {
        q = q0 + i;
        t[i] = Tb_BaseTime(tb_qBase[q]) + tb_qAt[q];
        stop[i] = -1.0;
        if (tb_qStopBase[q] >= 0) { stop[i] = Tb_BaseTime(tb_qStopBase[q]) + tb_qStop[q]; }
    }
    while (true) {
        best = -1;
        isStop = false;
        for (i = 0; i < n; i += 1) {
            if (!played[i] && (best == -1 || t[i] < when)) { best = i; when = t[i]; isStop = false; }
            if (played[i] && !stopped[i] && stop[i] >= 0.0 && (best == -1 || stop[i] < when)) { best = i; when = stop[i]; isStop = true; }
        }
        if (best == -1) { return now; }
        if (when > now) {
            Wait(when - now, c_timeGame);
            now = when;
        }
        if (gen != tb_gen) { return now; }
        q = q0 + best;
        if (isStop) {
            SoundStop(snd[best], true);
            stopped[best] = true;
        }
        else {
            played[best] = true;
            if (tb_qKind[q] == TB_CUE_SOUND) {
                Tb_Sound(tb_qText[q], on, at, atPoint);
                snd[best] = SoundLastPlayed();
            }
            else if (tb_qKind[q] == TB_CUE_ACTOR) { Tb_ActorCue(ua, tb_qChild[q], tb_qText[q]); }
            else if (tb_qKind[q] == TB_CUE_EFFECT) { Tb_Effect(tb_qText[q]); }
            else { Tb_ActorCue(ta, tb_qChild[q], tb_qText[q]); }
            Tb_FireRow(t[best], Tb_CueText(q, t[best]));
            tb_clock = now;
            Tb_ShowRead();
        }
    }
    return now;
}

void Tb_Respawn (int u, fixed after) {
    if (after > 0.0) { Wait(after, c_timeGame); }
    Tb_Spawn(u);
    Wait(0.5, c_timeGame);
    Tb_Idle(u);
}

// Plays the selection: the moment's do (an animation or a kill) and the variation's cues at its at.
void Tb_Play (bool withCues) {
    int u = tb_cur;
    int m = tb_mom;
    int k = tb_mDo[m];
    int a = tb_anim;
    int v = -1;
    int gen;
    unit who = tb_unit[u];
    point p = UnitGetPosition(who);
    actor ua = Tb_Actor(who);
    actor ta = null;
    fixed ran = 0.0;
    fixed len = 0.0;
    if (withCues) { v = Tb_VarIndex(); }
    if (tb_target != null && UnitIsAlive(tb_target)) { ta = Tb_Actor(tb_target); }
    tb_gen += 1;
    gen = tb_gen;
    Tb_ReadReset();

    tb_lastEnd = 0.0;
    tb_lastRan = 0.0;
    if (!UnitIsAlive(who)) { return; }
    if (k == TB_DO_PLAY && tb_uNAnim[u] > 0) {
        ActorSend(ua, tb_aPlay[u][a]);
        len = tb_aLen[u][a];
    }
    else if (k == TB_DO_KILL) {
        UnitSetState(who, c_unitStateInvulnerable, false);
        UnitKill(who);
        len = tb_uRespawn[u] + 0.5;
    }

    if (v >= 0) {
        if (tb_mAt[m] == TB_AT_TARGET && ta != null) { ran = Tb_RunCues(v, gen, tb_target, p, false, ua, ta); }
        else if (tb_mAt[m] == TB_AT_TARGET) { ran = Tb_RunCues(v, gen, who, Tb_Front(u), true, ua, ta); }
        else if (k == TB_DO_KILL) { ran = Tb_RunCues(v, gen, who, p, true, ua, ta); }
        else { ran = Tb_RunCues(v, gen, who, p, false, ua, ta); }
    }

    // An animation with a clear time (a hit reaction) is cleared then, not left to finish.
    if (k == TB_DO_PLAY && tb_uNAnim[u] > 0 && tb_aClear[u][a] > 0.0 && gen == tb_gen) {
        if (ran < tb_aClear[u][a]) { Wait(tb_aClear[u][a] - ran, c_timeGame); }
        if (gen == tb_gen) { ActorSend(ua, "AnimClear " + StringWord(tb_aPlay[u][a], 2)); }
        ran = MaxF(ran, tb_aClear[u][a]);
        len = tb_aClear[u][a];
    }
    if (k == TB_DO_KILL) {
        Tb_Respawn(u, MaxF(0.0, tb_uRespawn[u] - ran));
        ran = MaxF(ran, tb_uRespawn[u]) + 0.5;
    }
    tb_lastEnd = MaxF(ran, len);
    tb_lastRan = ran;
}

void Tb_Stop () {
    int u = tb_cur;
    tb_gen += 1;
    SoundStopAllTriggerSounds(true);
    if (Tb_Plays() && tb_uNAnim[u] > 0 && UnitIsAlive(tb_unit[u])) {
        ActorSend(Tb_Actor(tb_unit[u]), "AnimClear " + StringWord(tb_aPlay[u][tb_anim], 2));
    }
    Tb_Idle(u);
}

//--------------------------------------------------------------------------------------------------
// Retiming: the steppers and -t / -len. Every change is saved to the tuning bank, with what the build
// gave, for `testbed.js <spec> --apply` to write into the spec after the game.
//--------------------------------------------------------------------------------------------------

// To the nearest 0.001 s, so steps of 0.05 don't drift in fixed point.
fixed Tb_R (fixed f) {
    return IntToFixed(RoundI(f * 1000.0)) / 1000.0;
}

bool Tb_Tuned (fixed now, fixed built) {
    return AbsF(now - built) >= 0.0005;
}

// The selected animation's times, the way a stepper value shows them: gold once tuned.
string Tb_TuneText (fixed now, fixed built) {
    if (Tb_Tuned(now, built)) { return "<c val=\"" + TB_GOLD + "\">" + Tb_F(now) + "</c>"; }
    return Tb_F(now);
}

// The stepper row: shown with the Animation block, when the unit has an animation to retime.
void Tb_ShowTune () {
    int u = tb_cur;
    int a = tb_anim;
    bool show = Tb_Plays() && tb_uNAnim[u] > 0;
    DialogControlSetVisible(tb_sLabel, PlayerGroupAll(), show);
    DialogControlSetVisible(tb_sDown, PlayerGroupAll(), show);
    DialogControlSetVisible(tb_sVal, PlayerGroupAll(), show);
    DialogControlSetVisible(tb_sUp, PlayerGroupAll(), show);
    DialogControlSetVisible(tb_lLabel, PlayerGroupAll(), show);
    DialogControlSetVisible(tb_lDown, PlayerGroupAll(), show);
    DialogControlSetVisible(tb_lVal, PlayerGroupAll(), show);
    DialogControlSetVisible(tb_lUp, PlayerGroupAll(), show);
    DialogControlSetVisible(tb_lLink, PlayerGroupAll(), show && tb_aLink[u][a]);
    if (!show) { return; }
    Tb_Text(tb_sVal, Tb_TuneText(tb_aStrike[u][a], tb_aStrike0[u][a]));
    Tb_Text(tb_lVal, Tb_TuneText(tb_aLand[u][a], tb_aLand0[u][a]));
}

// Saves the selected animation's times, and what the build gave them, in its section of the bank.
void Tb_SaveTune () {
    int u = tb_cur;
    int a = tb_anim;
    string sec = tb_aSec[u][a];
    BankValueSetFromString(tb_bank, sec, "unit", tb_uName[u]);
    BankValueSetFromString(tb_bank, sec, "anim", tb_aName[u][a]);
    BankValueSetFromFixed(tb_bank, sec, "strike", tb_aStrike[u][a]);
    BankValueSetFromFixed(tb_bank, sec, "strikeBuilt", tb_aStrike0[u][a]);
    BankValueSetFromFixed(tb_bank, sec, "land", tb_aLand[u][a]);
    BankValueSetFromFixed(tb_bank, sec, "landBuilt", tb_aLand0[u][a]);
    BankValueSetFromFixed(tb_bank, sec, "length", tb_aLen[u][a]);
    BankValueSetFromFixed(tb_bank, sec, "lengthBuilt", tb_aLen0[u][a]);
    BankSave(tb_bank);
}

// Retimes the selected animation: a land given (setLand) breaks its link to the strike. Clamped to
// 0 <= strike <= land <= length; a strike pushed past the land pushes it. Saves, then shows it.
// Returns what the clamps changed ("" when nothing), for -t and -len to say.
string Tb_Retime (fixed strike, fixed land, bool setLand, fixed len) {
    int u = tb_cur;
    int a = tb_anim;
    string said = "";
    fixed s = Tb_R(strike);
    fixed l = Tb_R(land);
    fixed n = Tb_R(len);
    if (n < 0.05) { n = 0.05; said = said + ", length raised to 0.05"; }
    if (setLand) { tb_aLink[u][a] = false; }
    if (s < 0.0) { s = 0.0; said = said + ", strike raised to 0"; }
    if (s > n) { s = n; said = said + ", strike held to the length"; }
    if (tb_aLink[u][a]) { l = s; }
    else {
        if (l < s && setLand) { said = said + ", land raised to the strike"; }
        if (l < s) { l = s; }
        if (l > n) { l = n; said = said + ", land held to the length"; }
    }
    tb_aStrike[u][a] = s;
    tb_aLand[u][a] = l;
    tb_aLen[u][a] = n;
    Tb_SaveTune();
    Tb_ShowTune();
    Tb_ReadReset();
    if (said == "") { return ""; }
    return StringSub(said, 3, StringLength(said));
}

// A stepper press: no message, and no play; Play plays.
void Tb_Step (bool strike, fixed by) {
    int u = tb_cur;
    int a = tb_anim;
    if (strike) { Tb_Retime(tb_aStrike[u][a] + by, tb_aLand[u][a], false, tb_aLen[u][a]); }
    else { Tb_Retime(tb_aStrike[u][a], tb_aLand[u][a] + by, true, tb_aLen[u][a]); }
}

//--------------------------------------------------------------------------------------------------
// The GUI
//--------------------------------------------------------------------------------------------------

// The Animation block: shown only for a moment that plays one, on the selection's animation.
void Tb_FillAnims () {
    int a;
    bool show = Tb_Plays();
    tb_anim = Tb_AnimFor(Tb_VarIndex());
    DialogControlSetVisible(tb_animLabel, PlayerGroupAll(), show);
    DialogControlSetVisible(tb_animPd, PlayerGroupAll(), show);
    DialogControlRemoveAllItems(tb_animPd, PlayerGroupAll());
    for (a = 0; a < tb_uNAnim[tb_cur]; a += 1) {
        DialogControlAddItem(tb_animPd, PlayerGroupAll(), StringToText(tb_aName[tb_cur][a]));
    }
    if (tb_uNAnim[tb_cur] == 0) { DialogControlAddItem(tb_animPd, PlayerGroupAll(), StringToText("(no animations)")); }
    DialogControlSelectItem(tb_animPd, PlayerGroupAll(), tb_anim + 1);
    Tb_ShowTune();
}

// The unit and moment's variations, the pick marked *, then "(none)". Starts on the pick.
void Tb_FillVars () {
    int n = tb_vN[tb_cur][tb_mom];
    int v0 = tb_v0[tb_cur][tb_mom];
    int i;
    string mark;
    tb_var = n;
    if (n > 0) { tb_var = 0; }
    DialogControlRemoveAllItems(tb_varPd, PlayerGroupAll());
    for (i = 0; i < n; i += 1) {
        mark = "   ";
        if (tb_vPick[v0 + i]) { mark = "* "; tb_var = i; }
        DialogControlAddItem(tb_varPd, PlayerGroupAll(), StringToText(mark + IntToString(i + 1) + "  " + tb_vLabel[v0 + i]));
    }
    DialogControlAddItem(tb_varPd, PlayerGroupAll(), StringToText("(none: the action alone)"));
    DialogControlSetEnabled(tb_varPd, PlayerGroupAll(), n > 0);
    DialogControlSelectItem(tb_varPd, PlayerGroupAll(), tb_var + 1);
}

// The moments, each with the selected unit's count of variations.
void Tb_FillMoments () {
    int m;
    DialogControlRemoveAllItems(tb_momPd, PlayerGroupAll());
    for (m = 0; m < TB_NM; m += 1) {
        DialogControlAddItem(tb_momPd, PlayerGroupAll(), StringToText(tb_mName[m] + "  (" + IntToString(tb_vN[tb_cur][m]) + ")"));
    }
    DialogControlSelectItem(tb_momPd, PlayerGroupAll(), tb_mom + 1);
}

// After the unit or moment changes: its variations, then its animation, then the readout.
void Tb_Refill () {
    Tb_FillVars();
    Tb_FillAnims();
    Tb_ReadReset();
}

int Tb_Ctl (int type, int w, int h, int x, int y) {
    int c = DialogControlCreate(tb_dlg, type);
    DialogControlSetSize(c, PlayerGroupAll(), w, h);
    DialogControlSetPosition(c, PlayerGroupAll(), c_anchorTopLeft, x, y);
    return c;
}

int Tb_Button (string label, int w, int x, int y) {
    int c = Tb_Ctl(c_triggerControlTypeButton, w, 40, x, y);
    Tb_Text(c, label);
    return c;
}

bool Tb_OnEvent (bool testConds, bool runActions) {
    int c = EventDialogControl();
    int e = EventDialogControlEventType();
    int sel;
    string s;
    if (e == c_triggerControlEventTypeSelectionChanged) {
        if (c == tb_unitPd) {
            sel = DialogControlGetSelectedItem(c, 1) - 1;
            if (sel >= 0 && sel < TB_NU && sel != tb_cur) {
                tb_cur = sel;
                Tb_PlaceTarget();
                Tb_FillMoments();
                Tb_Refill();
            }
        }
        else if (c == tb_momPd) {
            sel = DialogControlGetSelectedItem(c, 1) - 1;
            if (sel >= 0 && sel < TB_NM && sel != tb_mom) { tb_mom = sel; Tb_Refill(); }
        }
        else if (c == tb_varPd) {
            sel = DialogControlGetSelectedItem(c, 1) - 1;
            if (sel >= 0 && sel <= tb_vN[tb_cur][tb_mom] && sel != tb_var) {
                tb_var = sel;
                Tb_FillAnims();
                Tb_ReadReset();
            }
        }
        else if (c == tb_animPd) {
            sel = DialogControlGetSelectedItem(c, 1) - 1;
            if (sel >= 0 && sel < tb_uNAnim[tb_cur] && sel != tb_anim) { tb_anim = sel; Tb_ShowTune(); Tb_ReadReset(); }
        }
    }
    else if (e == c_triggerControlEventTypeClick) {
        if (c == tb_play) { Tb_Play(true); }
        else if (c == tb_stop) { Tb_Stop(); }
        else if (c == tb_sDown) { Tb_Step(true, -TB_STEP); }
        else if (c == tb_sUp) { Tb_Step(true, TB_STEP); }
        else if (c == tb_lDown) { Tb_Step(false, -TB_STEP); }
        else if (c == tb_lUp) { Tb_Step(false, TB_STEP); }
        else if (c == tb_send) {
            s = DialogControlGetPropertyAsString(tb_edit, c_triggerControlPropertyEditText, 1);
            if (StringWord(s, 1) == "target" && tb_target != null) {
                ActorSend(Tb_Actor(tb_target), StringSub(s, 8, StringLength(s)));
                Tb_Msg("target actor: " + StringSub(s, 8, StringLength(s)));
            }
            else if (StringFind(s, " ", c_stringCase) == c_stringNotFound) {
                Tb_Sound(s, tb_unit[tb_cur], Tb_Home(tb_cur), !UnitIsAlive(tb_unit[tb_cur]));
                Tb_Msg("sound: " + s);
            }
            else {
                ActorSend(Tb_Actor(tb_unit[tb_cur]), s);
                Tb_Msg("actor: " + s);
            }
        }
    }
    else if (e == c_triggerControlEventTypeChecked && c == tb_loop) {
        tb_looping = DialogControlGetPropertyAsBool(tb_loop, c_triggerControlPropertyChecked, 1);
    }
    return true;
}

bool Tb_Loop (bool testConds, bool runActions) {
    while (true) {
        if (tb_looping) {
            Tb_Play(true);
            Wait(MaxF(0.0, tb_lastEnd - tb_lastRan) + 1.0, c_timeGame);
        }
        else { Wait(0.25, c_timeGame); }
    }
    return true;
}

void Tb_Help () {
    Tb_Msg("Testbed: pick a unit, a moment and a variation, then Play. * marks the spec's pick.");
    Tb_Msg("Send: a CSound id plays at the unit; text with a space goes to its actor; 'target <msg>' goes to the target's actor.");
    Tb_Msg("Strike and Land: step the selected animation's times; -t <strike> [land] sets them, -len <s> its length   -help: this");
    Tb_Msg("Retimes are saved: after quitting, run testbed.js <spec> --apply to write them into the spec.");
}

bool Tb_Chat (bool testConds, bool runActions) {
    string msg = EventChatMessage(false);
    string w1 = StringCase(StringWord(msg, 1), false);
    string w2 = StringWord(msg, 2);
    string w3 = StringWord(msg, 3);
    int u = tb_cur;
    int a = tb_anim;
    string said = "";
    if (w1 == "-help") { Tb_Help(); return true; }
    if (tb_uNAnim[u] == 0) { return true; }
    if (w1 == "-t" && w2 != "") {
        if (w3 != "") { said = Tb_Retime(StringToFixed(w2), StringToFixed(w3), true, tb_aLen[u][a]); }
        else { said = Tb_Retime(StringToFixed(w2), tb_aLand[u][a], false, tb_aLen[u][a]); }
    }
    else if (w1 == "-len" && w2 != "") { said = Tb_Retime(tb_aStrike[u][a], tb_aLand[u][a], false, StringToFixed(w2)); }
    else { return true; }
    if (said != "") { said = " (" + said + ")"; }
    Tb_Msg(tb_uName[u] + " / " + tb_aName[u][a] + ": strike " + Tb_F(tb_aStrike[u][a]) + ", land " + Tb_F(tb_aLand[u][a]) + ", length " + Tb_F(tb_aLen[u][a]) + said + ". Saved for --apply.");
    return true;
}

void Tb_Gui () {
    trigger t = TriggerCreate("Tb_OnEvent");
    int i;
    int y = 70;
    tb_dlg = DialogCreate(500, TB_DLG_H, c_anchorTopLeft, 20, 60, false);
    DialogSetTitle(tb_dlg, StringToText(TB_TITLE));

    Tb_Text(Tb_Ctl(c_triggerControlTypeLabel, 100, 30, 30, y + 5), "Unit");
    tb_unitPd = Tb_Ctl(c_triggerControlTypePulldown, 340, 40, 130, y);
    for (i = 0; i < TB_NU; i += 1) {
        DialogControlAddItem(tb_unitPd, PlayerGroupAll(), StringToText(tb_uName[i] + " (" + tb_uType[i] + ")"));
    }
    DialogControlSelectItem(tb_unitPd, PlayerGroupAll(), 1);
    y += 45;
    Tb_Text(Tb_Ctl(c_triggerControlTypeLabel, 100, 30, 30, y + 5), "Moment");
    tb_momPd = Tb_Ctl(c_triggerControlTypePulldown, 340, 40, 130, y);
    y += 45;
    Tb_Text(Tb_Ctl(c_triggerControlTypeLabel, 100, 30, 30, y + 5), "Variation");
    tb_varPd = Tb_Ctl(c_triggerControlTypePulldown, 340, 40, 130, y);
    y += 45;
    tb_note = Tb_Ctl(c_triggerControlTypeLabel, 440, 50, 30, y);
    y += 55;
    tb_animLabel = Tb_Ctl(c_triggerControlTypeLabel, 100, 30, 30, y + 5);
    Tb_Text(tb_animLabel, "Animation");
    tb_animPd = Tb_Ctl(c_triggerControlTypePulldown, 340, 40, 130, y);
    y += 45;
    tb_sLabel = Tb_Ctl(c_triggerControlTypeLabel, 60, 30, 30, y + 5);
    Tb_Text(tb_sLabel, "Strike");
    tb_sDown = Tb_Button("-", 34, 90, y);
    tb_sVal = Tb_Ctl(c_triggerControlTypeLabel, 48, 30, 130, y + 5);
    tb_sUp = Tb_Button("+", 34, 178, y);
    tb_lLabel = Tb_Ctl(c_triggerControlTypeLabel, 50, 30, 226, y + 5);
    Tb_Text(tb_lLabel, "Land");
    tb_lDown = Tb_Button("-", 34, 276, y);
    tb_lVal = Tb_Ctl(c_triggerControlTypeLabel, 48, 30, 316, y + 5);
    tb_lUp = Tb_Button("+", 34, 364, y);
    tb_lLink = Tb_Ctl(c_triggerControlTypeLabel, 70, 30, 404, y + 5);
    Tb_Text(tb_lLink, "= strike");
    y += 50;
    tb_play = Tb_Button("Play", 90, 30, y);
    tb_stop = Tb_Button("Stop", 90, 125, y);
    tb_loop = Tb_Ctl(c_triggerControlTypeCheckBox, 30, 30, 235, y + 5);
    Tb_Text(Tb_Ctl(c_triggerControlTypeLabel, 70, 30, 270, y + 8), "Loop");
    y += 55;
    tb_read = Tb_Ctl(c_triggerControlTypeLabel, 440, TB_DLG_H - y - 100, 30, y);
    tb_edit = Tb_Ctl(c_triggerControlTypeEditBox, 340, 40, 30, TB_DLG_H - 85);
    tb_send = Tb_Button("Send", 90, 380, TB_DLG_H - 85);

    Tb_FillMoments();
    TriggerAddEventDialogControl(t, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(t, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeChecked);
    TriggerAddEventDialogControl(t, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeSelectionChanged);
    DialogSetVisible(tb_dlg, PlayerGroupAll(), true);
    Tb_Refill();
}

// The tour: selects each stop's state as the pulldowns would, plays it in its own thread, and saves
// the stop in the bank after its hold; -1 when done.
bool Tb_TourPlay (bool testConds, bool runActions) {
    Tb_Play(true);
    return true;
}

bool Tb_Tour (bool testConds, bool runActions) {
    bank b = BankLoad(TB_TOUR_BANK, 1);
    int i;
    Wait(4.0, c_timeGame);       // let the window settle before the first frame
    for (i = 0; i < tb_ntour; i += 1) {
        tb_cur = tb_tU[i];
        tb_mom = tb_tM[i];
        Tb_PlaceTarget();
        Tb_Focus(tb_cur);
        DialogControlSelectItem(tb_unitPd, PlayerGroupAll(), tb_cur + 1);
        Tb_FillMoments();
        Tb_FillVars();
        if (tb_tV[i] < 0) { tb_var = tb_vN[tb_cur][tb_mom]; }
        else if (tb_tV[i] < tb_vN[tb_cur][tb_mom]) { tb_var = tb_tV[i]; }
        DialogControlSelectItem(tb_varPd, PlayerGroupAll(), tb_var + 1);
        Tb_FillAnims();
        if (tb_tA[i] >= 0) {
            tb_anim = tb_tA[i];
            DialogControlSelectItem(tb_animPd, PlayerGroupAll(), tb_anim + 1);
            Tb_ShowTune();
        }
        Tb_ReadReset();
        Wait(0.5, c_timeGame);
        TriggerExecute(TriggerCreate("Tb_TourPlay"), false, false);
        Wait(tb_tHold[i], c_timeGame);
        BankValueSetFromInt(b, "tour", "stop", i + 1);
        BankSave(b);
        // Long enough for the Host to see the stop and take its frame before the next: its watch loop
        // has been seen taking 13 s between polls, and a stop it misses has no frame.
        Wait(15.0, c_timeReal);
        Tb_Stop();
        // A kill stop waits for the unit to come back before the next stop.
        if (tb_mDo[tb_mom] == TB_DO_KILL) { Wait(tb_uRespawn[tb_cur] + 1.0, c_timeGame); }
        else { Wait(0.5, c_timeGame); }
    }
    BankValueSetFromInt(b, "tour", "stop", -1);
    BankSave(b);
    return true;
}

// The target: real damage reaches it, so an effect cue can kill it; it comes back in front of the selected unit.
void Tb_SpawnTarget () {
    UnitCreate(1, TB_TARGET, c_unitCreateIgnorePlacement, TB_TARGET_PLAYER, Tb_Front(tb_cur), TB_FACING + 180.0);
    tb_target = UnitLastCreated();
    Tb_PlaceTarget();
}

bool Tb_TargetDied (bool testConds, bool runActions) {
    if (EventUnit() != tb_target) { return true; }
    Wait(TB_TARGET_RESPAWN, c_timeGame);
    Tb_SpawnTarget();
    return true;
}

bool Tb_Start (bool testConds, bool runActions) {
    trigger t;
    int u;
    if (!TB_FOG) {
        VisEnable(c_visTypeMask, false);
        VisEnable(c_visTypeFog, false);
    }
    Tb_Data();
    tb_bank = BankLoad(TB_TUNE_BANK, 1);
    for (u = 0; u < TB_NU; u += 1) { Tb_Spawn(u); }
    if (TB_TARGET != "") {
        Tb_SpawnTarget();
        t = TriggerCreate("Tb_TargetDied");
        TriggerAddEventUnitDied(t, null);
    }
    CameraPan(1, Point(TB_X + TB_GAP * IntToFixed(TB_NU - 1) / 2.0, TB_Y - 2.5), 0.0, -1.0, 0.0, false);
    Tb_Gui();
    Wait(0.5, c_timeGame);       // a new unit's actor isn't there to take messages straight away
    for (u = 0; u < TB_NU; u += 1) { Tb_Idle(u); }
    if (tb_ntour == 0) { Tb_Help(); }     // a tour's frames show the dialog, not the help
    t = TriggerCreate("Tb_Chat");
    TriggerAddEventChatMessage(t, 1, "-", false);
    TriggerExecute(TriggerCreate("Tb_Loop"), false, false);
    if (tb_ntour > 0) { TriggerExecute(TriggerCreate("Tb_Tour"), false, false); }
    return true;
}

void Tb_Init () {
    trigger t = TriggerCreate("Tb_Start");
    TriggerAddEventMapInit(t);
}
