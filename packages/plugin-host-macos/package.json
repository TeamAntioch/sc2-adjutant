{
  "name": "@team-antioch/sc2-adjutant-host-macos",
  "version": "0.1.1",
  "description": "The macOS Host Adapter Plugin for sc2-adjutant: opens the Galaxy Editor, runs Test Document, captures tours and the screen, speaks placeholder voices and renders game models.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TeamAntioch/sc2-adjutant.git",
    "directory": "packages/plugin-host-macos"
  },
  "type": "module",
  "exports": {
    "./sc2-adjutant-plugin.json": "./sc2-adjutant-plugin.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "sc2-adjutant-plugin.json",
    "docs",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').writeFileSync('dist/.built', '')\"",
    "prepack": "npm run build",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "@team-antioch/sc2-adjutant": "^0.1.0"
  }
}
