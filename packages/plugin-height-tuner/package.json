{
  "name": "@team-antioch/sc2-adjutant-height-tuner",
  "version": "0.1.1",
  "description": "An sc2-adjutant Utility that builds a terrain texture height-map test map: strips of candidate normal maps, each painted from 0 to 100% over a base texture, for judging in game.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TeamAntioch/sc2-adjutant.git",
    "directory": "packages/plugin-height-tuner"
  },
  "type": "module",
  "exports": {
    "./sc2-adjutant-plugin.json": "./sc2-adjutant-plugin.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "sc2-adjutant-plugin.json",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../core/scripts/write-built-stamp.mjs",
    "prepack": "pnpm run build",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "@team-antioch/sc2-adjutant": "^0.1.0"
  }
}
