bool gt_zeratulReachesField_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    while (!((gv_script_transmissions_playing == false))) {
        Wait(0.25, c_timeGame);
    }
    gv_script_transmissions_playing = true;
    TransmissionWait(TransmissionLastSent(), 0.0);
    gv_script_line_sent = false;
    while ((gv_script_line_sent == false)) {
        libBel1_gf_HoldHeroMomentsForLine();
        while (!((gv_script_trigger_scene == 0))) {
            Wait(0.25, c_timeGame);
        }
        gv_script_line_cut = false;
        TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(26469087), true, false, "Talk"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "", "Talk", SoundLink("radio_field-3-1", -1), StringExternal("Param/Value/E6A30D10"), StringExternal("Param/Value/70C0CDEA"), 0.0, c_transmissionDurationAdd, false, c_maxPlayers, false);
        gv_script_line = TransmissionLastSent();
        TransmissionWait(gv_script_line, 0.0);
        gv_script_line_sent = (gv_script_line_cut == false);
    }
    libBel1_gf_ReleaseHeroMomentsAfterLine();
    gv_script_line_sent = false;
    while ((gv_script_line_sent == false)) {
        libBel1_gf_HoldHeroMomentsForLine();
        while (!((gv_script_trigger_scene == 0))) {
            Wait(0.25, c_timeGame);
        }
        gv_script_line_cut = false;
        TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(26469087), true, false, "Talk"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "", "Talk", SoundLink("radio_field-3-2", -1), StringExternal("Param/Value/B19D20F1"), StringExternal("Param/Value/8E5BF047"), 0.0, c_transmissionDurationAdd, false, c_maxPlayers, false);
        gv_script_line = TransmissionLastSent();
        TransmissionWait(gv_script_line, 0.0);
        gv_script_line_sent = (gv_script_line_cut == false);
    }
    libBel1_gf_ReleaseHeroMomentsAfterLine();
    gv_script_transmissions_playing = false;
    return true;
}

