exports[`core's catalog through the templates > writes every block, nested, as the compile's hand-written block renderers did 1`] = `
"//==================================================================================================
// 
// Generated Map Script
// 
// Name:   Blocks
// 
//==================================================================================================
include "TriggerLibs/NativeLib"

//--------------------------------------------------------------------------------------------------
// Library Initialization
//--------------------------------------------------------------------------------------------------
void InitLibs () {
    libNtve_InitLib();
}

//--------------------------------------------------------------------------------------------------
// Global Variables
//--------------------------------------------------------------------------------------------------
bool gv_gate_open;
unit gv_hero;

void InitGlobals () {
}

//--------------------------------------------------------------------------------------------------
// Trigger Variables
//--------------------------------------------------------------------------------------------------
trigger gt_EveryBlock;

//--------------------------------------------------------------------------------------------------
// Trigger: Every Block
//--------------------------------------------------------------------------------------------------
bool gt_EveryBlock_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup auto20000024_g;
    int auto20000024_u;
    unit auto20000024_var;

    // Conditions
    if (testConds) {
        if (!((gv_gate_open == false))) {
            return false;
        }

        if (!((gv_gate_open == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((gv_gate_open == true) && (gv_gate_open == false)) {
        Wait(1.0, c_timeGame);
    }
    else {
        Wait(2.0, c_timeGame);
        gv_gate_open = true;
    }
    auto20000024_g = UnitGroup(null, 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    auto20000024_u = UnitGroupCount(auto20000024_g, c_unitCountAll);
    for (;; auto20000024_u -= 1) {
        auto20000024_var = UnitGroupUnitFromEnd(auto20000024_g, auto20000024_u);
        if (auto20000024_var == null) { break; }
        if ((UnitIsAlive(auto20000024_var) == true)) {
            UnitKill(auto20000024_var);
        }

    }
    while ((gv_gate_open == false)) {
        Wait(0.5, c_timeGame);
    }
    while (!((gv_gate_open == true))) {
        Wait(1.0, c_timeGame);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_EveryBlock_Init () {
    gt_EveryBlock = TriggerCreate("gt_EveryBlock_Func");
    TriggerAddEventUnitDied(gt_EveryBlock, UnitRefFromVariable("gv_hero"));
    TriggerAddEventUnitRange(gt_EveryBlock, UnitRefFromVariable("gv_hero"), UnitFromId(7), 8.0, true);
}

//--------------------------------------------------------------------------------------------------
// Trigger Initialization
//--------------------------------------------------------------------------------------------------
void InitTriggers () {
    gt_EveryBlock_Init();
}

//--------------------------------------------------------------------------------------------------
// Map Initialization
//--------------------------------------------------------------------------------------------------
void InitMap () {
    InitLibs();
    InitGlobals();
    InitTriggers();
}
"
`;
