  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": true,
    },
    "description": "Doodad Search's narrowing step: a keyword and facet search over the game's doodads (core's doodad catalog), its terrain objects and the Workspace's Campaign Mod's doodads, with the Workspace's Doodad Uses (doodad-notes.json beside its config) merged in. Words match whole words in a doodad's name, id (split at its camel case, so crusher finds PortZionCrusherDoodad), look or Doodad Uses, in any plural or inflected form (crate finds crates but not crater; press finds presses and pressed); a word ending in * matches the start of a word instead (stamp* finds stamper), and a word of several words matches them in a row; the most words matched rank first. Facets narrow by the catalog's description (a terrain object has no size or role; a doodad for any biome fits every biome). A Campaign Mod doodad matches on its entry in the mod's doodad index (mods/<id>/doodad-catalog.json: description, Doodad Uses and sheet) as a game doodad does on core's; one whose description wasn't written for its current model is marked pending (run index_mod_doodads, then describe it); one with no description at all matches by name and id alone and never passes a facet; and one with nothing to draw gives why as unpictured. A game doodad the mod gave a model of its own is the mod's. Each result gives its id, name, source, package, the map dependency it needs and, for a Mission, whether the Mission's dependencies already bring it in (those sort first), its description, Doodad Uses (the published sc2-asset-catalog package's, then the Workspace's: each a phrase with the variation, scale and source it was accepted with, when set), variation count, its facing when a game doodad has one (front: the degrees its face points at rotation 0, counterclockwise from east; placement: wall-foot, wall-face, wall-top or free, with its stand-off from a wall zone's edge and height; source: measured, the author's, which a set piece member's yaw and against: "wall" use, or sheet, read from its catalog renders, whose front they use only when sure and not diagonal and whose placement and stand-off are suggestions), and picture: its turntable sheet (variation 00 from four sides) when this machine has one, else its gallery picture (one angle: say so when judging from it), else none; and whether the renders a sheet is built from are here (then offer to build it: build_doodad_sheets builds sheets by id, and build_doodad_search_page with buildSheets builds a search's candidates'). Reads only.",
    "execution": {
      "taskSupport": "forbidden",
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "biome": {
          "description": "Biomes, any of which it must have, such as urban or space",
          "items": {
            "minLength": 1,
            "type": "string",
          },
          "type": "array",
        },
        "kind": {
          "description": "Only doodads of this kind",
          "enum": [
            "natural",
            "built",
            "creature",
          ],
          "type": "string",
        },
        "limit": {
          "description": "At most this many results; 30 by default",
          "maximum": 500,
          "minimum": 1,
          "type": "integer",
        },
        "mission": {
          "description": "The Mission to sort for: the doodads its dependencies already bring in first",
          "minLength": 1,
          "type": "string",
        },
        "package": {
          "description": "The SC2GameData package that defines it, such as campaigns/void.sc2campaign",
          "minLength": 1,
          "type": "string",
        },
        "role": {
          "description": "Roles, any of which it must have, such as prop or clutter",
          "items": {
            "enum": [
              "cliff",
              "structure",
              "prop",
              "clutter",
              "foliage",
              "decal",
              "effect",
            ],
            "type": "string",
          },
          "type": "array",
        },
        "size": {
          "description": "Only doodads of this size",
          "enum": [
            "tiny",
            "small",
            "medium",
            "large",
            "huge",
          ],
          "type": "string",
        },
        "story": {
          "description": "Stories, any of which it must have, such as industry or terran",
          "items": {
            "minLength": 1,
            "type": "string",
          },
          "type": "array",
        },
        "words": {
          "description": "Keywords, any of which must match; leave out to search by facets alone",
          "items": {
            "minLength": 1,
            "type": "string",
          },
          "type": "array",
        },
        "workspace": {
          "description": "The Workspace this call is about, when it isn't the one the session is in: its folder, a git worktree of it, or any folder inside either (such as a Mission's), absolute. The nearest folder at or above it that holds the Workspace config serves, so a Mission that exists only in a worktree is read and written there, not in the main checkout. Without it the session's working folder serves (the MCP roots), else the Workspace the server started with",
          "minLength": 1,
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "search_doodads",
    "outputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
