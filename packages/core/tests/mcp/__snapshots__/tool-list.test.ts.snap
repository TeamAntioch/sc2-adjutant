  {
    "annotations": {
      "destructiveHint": true,
      "readOnlyHint": false,
    },
    "description": "Applies a JSON Patch (RFC 6902) to a Mission's Blueprint and saves it if the result validates against core and every Mechanic the Workspace's Plugins provide. Otherwise nothing is saved and the reply gives each problem's path and reason. Paths are JSON Pointers into the stored Blueprint, as get_blueprint returns it.",
    "execution": {
      "taskSupport": "forbidden",
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "mission": {
          "description": "The Mission's folder name in the Workspace's missions folder",
          "minLength": 1,
          "type": "string",
        },
        "patch": {
          "description": "The JSON Patch operations, applied in order: all or none",
          "items": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "op": {
                    "const": "add",
                    "type": "string",
                  },
                  "path": {
                    "description": "A JSON Pointer (RFC 6901), such as "/zones/0/polygon/2" or "/anchors/-" to append; "~1" stands for "/" and "~0" for "~"",
                    "type": "string",
                  },
                  "value": {},
                },
                "required": [
                  "op",
                  "path",
                  "value",
                ],
                "type": "object",
              },
              {
                "additionalProperties": false,
                "properties": {
                  "op": {
                    "const": "remove",
                    "type": "string",
                  },
                  "path": {
                    "description": "A JSON Pointer (RFC 6901), such as "/zones/0/polygon/2" or "/anchors/-" to append; "~1" stands for "/" and "~0" for "~"",
                    "type": "string",
                  },
                },
                "required": [
                  "op",
                  "path",
                ],
                "type": "object",
              },
              {
                "additionalProperties": false,
                "properties": {
                  "op": {
                    "const": "replace",
                    "type": "string",
                  },
                  "path": {
                    "description": "A JSON Pointer (RFC 6901), such as "/zones/0/polygon/2" or "/anchors/-" to append; "~1" stands for "/" and "~0" for "~"",
                    "type": "string",
                  },
                  "value": {},
