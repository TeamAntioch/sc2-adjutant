  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": false,
    },
    "description": "Makes a Mission from a Map Package built outside the Workspace (Import, ADR-0010). Copies the package byte for byte to <missions>/<mission>/<Name>.SC2Map, never writing to the source, and writes a minimal Blueprint read from it (id, title, Campaign, setting, map size, tileset, dependencies, and the Screenplay reference when the Campaign's Screenplay Source knows the package's conversation, which is then pulled) and an empty compile record: everything in the package starts as Kept Content. The Blueprint has no Zones or Beats, so the layout checks skip and a compile leaves the terrain, map info and triggers as they are. The Editor's default map name is replaced with the title.",
    "execution": {
      "taskSupport": "forbidden",
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "mission": {
          "description": "The new Mission's id, which is also its folder name: lowercase letters, numbers, hyphens and underscores",
          "minLength": 1,
          "type": "string",
        },
        "setting": {
          "description": "One line on where the Mission is set; by default where it was imported from",
          "minLength": 1,
          "type": "string",
        },
        "source": {
          "description": "The unpacked .SC2Map folder to import: absolute, or relative to the Workspace root. Only read",
          "minLength": 1,
          "type": "string",
        },
        "title": {
          "description": "The Mission's title; by default the map's own name, or its file name while that is the Editor's default",
          "minLength": 1,
          "type": "string",
        },
        "workspace": {
          "description": "The Workspace this call is about, when it isn't the one the session is in: its folder, a git worktree of it, or any folder inside either (such as a Mission's), absolute. The nearest folder at or above it that holds the Workspace config serves, so a Mission that exists only in a worktree is read and written there, not in the main checkout. Without it the session's working folder serves (the MCP roots), else the Workspace the server started with",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "source",
        "mission",
      ],
      "type": "object",
    },
    "name": "import_map",
    "outputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "blueprint": {
          "type": "string",
        },
        "mapPackage": {
          "type": "string",
        },
      },
      "required": [
        "blueprint",
        "mapPackage",
      ],
      "type": "object",
    },
    "title": "Import a map",
  },
  {
    "annotations": {
      "destructiveHint": false,
