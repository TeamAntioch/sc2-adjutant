        "mod": {
          "description": "The new mod's id, which is also its folder name in mods/: lowercase letters, numbers, hyphens and underscores",
          "minLength": 1,
          "type": "string",
        },
        "source": {
          "description": "The unpacked .SC2Mod folder to import: absolute, or relative to the Workspace root. Only read",
