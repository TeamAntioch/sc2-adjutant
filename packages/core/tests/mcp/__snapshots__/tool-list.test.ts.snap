  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": true,
    },
    "description": "What every variation of every decal doodad (kind decal) shows, from the published sc2-asset-catalog's decal descriptions (described by eye from each variation's picture), filtered. Each match gives its doodad and variation number, look, what it shows, glyphs (none, number, letter, words, or script for Protoss and Xel'Naga inscriptions) with the text it reads, shape (line, corner or patch), whether copies tile end to end, use (marking or ornament, which can go anywhere; label, sign or emblem, which go only where they mean something), and, once the package's extract-decals has read this machine's install into its cache, its texture, its box in cells and its doodad's sheet of every variation. A painted number, letter or word promises it labels something, so dressing never scatters those: for plain floor markings ask for glyphs [none] and use [marking], and name a bay's number or a lane's words in a member's variations. Reads only.",
    "execution": {
      "taskSupport": "forbidden",
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "doodads": {
          "description": "Decal doodads, any of which it must belong to, such as Decal or DOM_Decals",
          "items": {
            "minLength": 1,
            "type": "string",
          },
          "type": "array",
        },
        "glyphs": {
          "description": "Glyphs, any of which it must carry: [none] for no writing at all",
          "items": {
            "enum": [
              "none",
              "number",
              "letter",
              "words",
              "script",
            ],
            "type": "string",
          },
          "type": "array",
        },
        "limit": {
          "description": "At most this many in the text; every match is in the structured result",
          "maximum": 500,
          "minimum": 1,
          "type": "integer",
        },
        "scatterable": {
          "description": "Only what dressing may scatter at random (true), or only what it never does (false)",
          "type": "boolean",
        },
        "shape": {
          "description": "Shapes, any of which it must have: line, corner or patch",
          "items": {
            "enum": [
              "line",
              "corner",
              "patch",
            ],
            "type": "string",
          },
          "type": "array",
        },
        "shows": {
          "description": "What it shows, any of which it must, such as stripe or arrow",
          "items": {
            "enum": [
              "stripe",
              "curve",
              "corner",
              "hazard-stripes",
              "arrow",
              "frame",
              "hazard-sign",
              "symbol",
              "emblem",
              "text",
              "number",
              "ornament",
              "glow-line",
              "light-strip",
            ],
            "type": "string",
          },
          "type": "array",
        },
        "tiles": {
          "description": "Only decals whose copies tile end to end (true), or only those that don't (false)",
          "type": "boolean",
        },
        "use": {
          "description": "Uses, any of which it must have, such as marking or sign",
          "items": {
            "enum": [
              "marking",
              "ornament",
              "label",
              "sign",
              "emblem",
            ],
            "type": "string",
          },
          "type": "array",
        },
        "words": {
          "description": "Words, any of which its look, text or shows must contain, such as caution or arrow",
          "items": {
            "minLength": 1,
            "type": "string",
          },
          "type": "array",
        },
        "workspace": {
          "description": "The Workspace this call is about, when it isn't the one the session is in: its folder, a git worktree of it, or any folder inside either (such as a Mission's), absolute. The nearest folder at or above it that holds the Workspace config serves, so a Mission that exists only in a worktree is read and written there, not in the main checkout. Without it the session's working folder serves (the MCP roots), else the Workspace the server started with",
          "minLength": 1,
          "type": "string",
        },
      },
      "type": "object",
    },
