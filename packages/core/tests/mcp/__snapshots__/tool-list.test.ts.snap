  {
    "annotations": {
      "destructiveHint": true,
      "readOnlyHint": false,
    },
    "description": "Imports a cinematic set into a Mission or a mod as data, at <its folder>/sets/<set id>.json (for a mod's Cinematics, mods/<id>/sets/), from the Cutscene Editor files where the set catalog (data/cinematic-sets) finds it: its pieces (model, transform, variation, tint), marks (each with its look-at at another mark), named cameras (orbit cameras, and target cameras converted to orbit values; a moving one at its first frame, marked moves), base Lights, lamps (one attached to a character attached to its mark) and its ambience (each Sound looping all through the file; other Sounds are listed as cues for a Cinematic's sounds), in the set's own frame, with the source file recorded. A Cinematic then compiles without the source files. It reads the set's richest occurrence among the sources, unless file names another. Importing again replaces the file.",
    "execution": {
      "taskSupport": "forbidden",
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "file": {
          "description": "The occurrence to read instead of the richest: its path in its source, or its file name",
          "minLength": 1,
          "type": "string",
        },
        "mission": {
          "description": "The Mission to import it into; give this or mod",
          "minLength": 1,
          "type": "string",
        },
        "mod": {
          "description": "The Workspace mod to import it into, for its Cinematics; give this or mission",
          "minLength": 1,
          "type": "string",
        },
        "set": {
          "description": "The set's catalog name, such as "Interior (Command Center Arrival)", or its id",
          "minLength": 1,
          "type": "string",
        },
        "sources": {
          "description": "The folders to read, as catalog-sets takes them",
          "items": {
            "properties": {
              "dir": {
                "description": "The folder of Cutscene Editor files, absolute or relative to the Workspace root",
                "minLength": 1,
                "type": "string",
              },
              "kind": {
                "description": "The source kind: blizzard for Blizzard's game data, or one a Workspace Plugin contributes for a Campaign's repo",
                "minLength": 1,
                "type": "string",
              },
            },
            "required": [
              "kind",
              "dir",
            ],
            "type": "object",
          },
          "minItems": 1,
          "type": "array",
