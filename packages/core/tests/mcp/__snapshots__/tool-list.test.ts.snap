  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": false,
    },
    "description": "Opens the Doodad Finder's page for the author (served when the doodad-finder package, an optional dependency of core, is installed): use it when the author asks to open the Doodad Finder. Before a start it checks what the Finder needs and says each plainly: core built, the Workspace, the embeddings model cached (else the first start downloads about 34 MB and embeds every card, around 20 s), whether Jev has its key (TYPESAFE_API_KEY, or the key file \`npx @team-antioch/sc2-doodad-finder login\` saves; never the key itself), and how many catalog entries have no picture here. A missing one doesn't block: it says what is off and the command that fixes it. Pass those on to the author. Then it reuses a Finder already answering for this Workspace, or starts one detached, so it outlives the session, with its pid and port in the Workspace's git-ignored output/doodad-finder/finder.json and its output in finder.log there (the research archive's doodad-finder/process/ with no Workspace). It waits until the page answers, up to 120 s, and opens it: the default browser, a Chrome app window with window app (on macOS with Chrome; elsewhere the default browser, with a note), or nowhere with window none (the URL alone). A start that doesn't answer in time is an error; the Finder is left running, and a later call waits for it. stop true stops the Finder this tool started, by its pid file, and nothing else. The answer gives the URL, whether it was started or reused, the rankers on and off, and the checks (none on a reuse). If the page can't be opened, a note says so and gives the URL to open by hand.",
    "execution": {
      "taskSupport": "forbidden",
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "stop": {
          "description": "True stops the Finder this tool started for the Workspace instead of opening one",
          "type": "boolean",
        },
        "window": {
          "description": "Where the page opens: browser (the default browser, by default), app (a Chrome app window, on macOS when Chrome is installed; elsewhere the default browser) or none (give the URL alone)",
          "enum": [
            "browser",
            "app",
            "none",
          ],
          "type": "string",
        },
        "workspace": {
          "description": "The Workspace this call is about, when it isn't the one the session is in: its folder, a git worktree of it, or any folder inside either (such as a Mission's), absolute. The nearest folder at or above it that holds the Workspace config serves, so a Mission that exists only in a worktree is read and written there, not in the main checkout. Without it the session's working folder serves (the MCP roots), else the Workspace the server started with",
          "minLength": 1,
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "open_doodad_finder",
    "outputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "started",
            "reused",
            "stopped",
            "notRunning",
          ],
          "type": "string",
        },
        "checks": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
              },
              "note": {
                "type": "string",
              },
              "ok": {
                "type": "boolean",
              },
            },
            "required": [
              "name",
              "ok",
              "note",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "logFile": {
          "type": "string",
        },
        "notes": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "opened": {
          "enum": [
            "browser",
            "app",
            "none",
          ],
          "type": "string",
        },
        "ours": {
          "type": "boolean",
        },
        "pidFile": {
          "type": "string",
        },
        "rankers": {
          "additionalProperties": false,
          "properties": {
            "off": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "ranker": {
                    "type": "string",
                  },
                  "reason": {
                    "type": "string",
                  },
                },
                "required": [
                  "ranker",
                  "reason",
                ],
                "type": "object",
              },
              "type": "array",
            },
            "on": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
          },
          "required": [
            "on",
            "off",
          ],
          "type": "object",
        },
        "url": {
          "type": "string",
        },
      },
      "required": [
