          "minLength": 1,
          "type": "string",
        },
        "mod": {
          "description": "The mod's id, as the Workspace config's mods names it (its folder in mods/); give this or mission",
          "minLength": 1,
          "type": "string",
        },
        "ref": {
          "description": "What the Screenplay Source knows its Screenplay by, when the Source can't tell from the conversation",
          "minLength": 1,
          "type": "string",
        },
        "renumber": {
          "description": "The author renumbered the Screenplay at its Source on purpose: pair its lines with the Conversation's in order and make the Kept references follow the new ids; needs accept",
          "type": "boolean",
        },
        "source": {
          "description": "The Screenplay file in the mod's folder; screenplays/<conversation>.md when not given. Without a Screenplay Source, it must already be there",
          "minLength": 1,
          "type": "string",
