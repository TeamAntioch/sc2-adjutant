  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": true,
    },
    "description": "Searches the trigger functions in reach of a Mission (the game's libraries and those of the mods its dependencies load) or, without one, the game's: by words of the name or identifier, category, kind (action, function, condition, event), the types of parameter it takes and its return type, each type by the Editor's name (Unit Group) or its own (unitgroup). Each hit is given as the Editor's function list shows it: its name, library, category, kind, parameters' names and types, return type and hint. Ids only when \`ids\` is set.",
    "execution": {
      "taskSupport": "forbidden",
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "category": {
          "description": "Words found in its category (Unit Group > Groups)",
          "minLength": 1,
          "type": "string",
        },
        "ids": {
          "description": "Give each function's and parameter's Id (<library>/<id>)",
          "type": "boolean",
        },
        "kind": {
          "description": "Its kind: action, function, condition or event",
          "enum": [
            "action",
            "function",
            "condition",
            "event",
          ],
          "type": "string",
        },
        "library": {
          "description": "Its library, by id (Ntve) or name (Built-In)",
          "minLength": 1,
          "type": "string",
        },
        "limit": {
          "description": "Hits given at most (25 by default)",
          "exclusiveMinimum": 0,
          "maximum": 200,
          "type": "integer",
        },
        "mission": {
          "description": "The Mission's folder name in the Workspace's missions folder",
          "minLength": 1,
          "type": "string",
        },
        "returns": {
          "description": "Its return type",
          "minLength": 1,
          "type": "string",
        },
        "takes": {
          "description": "Types it takes a parameter of, each",
          "items": {
            "minLength": 1,
            "type": "string",
          },
          "type": "array",
        },
        "text": {
          "description": "Words each found in the function's name or identifier",
          "minLength": 1,
          "type": "string",
        },
        "workspace": {
          "description": "The Workspace this call is about, when it isn't the one the session is in: its folder, a git worktree of it, or any folder inside either (such as a Mission's), absolute. The nearest folder at or above it that holds the Workspace config serves, so a Mission that exists only in a worktree is read and written there, not in the main checkout. Without it the session's working folder serves (the MCP roots), else the Workspace the server started with",
          "minLength": 1,
          "type": "string",
        },
      },
      "type": "object",
    },
