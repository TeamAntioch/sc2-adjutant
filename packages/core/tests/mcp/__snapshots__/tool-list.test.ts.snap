  {
    "annotations": {
      "destructiveHint": true,
      "readOnlyHint": false,
    },
    "description": "Compiles a Mission's Blueprint into a Map Package the Galaxy Editor opens, with its terrain, objects, regions and triggers. By default it compiles in place, into the Mission's committed package beside its Blueprint: the compile record there (compile-record.json) lists what the last compile wrote, which is replaced, and everything else in the package (Kept Content, such as the author's own doodads, units, regions and strings) is left byte for byte. Kept triggers stay beside the compiled ones, their XML and Galaxy as the Editor wrote them. When the author has changed Compiled Content in the Editor since the last compile, the compile stops, writing nothing, and lists each change by entry (object:<id>, region:<id>, trigger:<id>, string:<file>:<key>, file:<path>): run sync first for what it brings back (moved Anchors, redrawn regions), and for the rest ask the author whether to keep each one (it stays as the Editor left it and leaves the record, as Kept Content the Blueprint no longer writes) or discard it (overwritten), then compile again with keep, discard, keepAll or discardAll. A Screenplay line with no voice file (<sound id>.ogg or .wav in the Screenplay's audioDir) gets a placeholder at its final path: spoken when the machine's Host Adapter can speak, silent otherwise. Voice files go into the package as .ogg, a .wav encoded with ffmpeg, unless screenplay.script.voiceFormat is wav. Returns where it wrote the package and any warnings for the author. Refuses, writing nothing, while the Editor has the package open (when the machine's Host Adapter can tell): ask the author to close the map in the Editor without saving, then compile again. With refresh, an open map is instead closed from the Editor's File menu (never saved, and refused while the Editor's title shows unsaved changes), the package is compiled, and the same map is opened again; it needs the Editor in front, so it refuses when the author is in another app.",
    "execution": {
      "taskSupport": "forbidden",
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "discard": {
          "description": "Entries the compile listed as changed in the Editor to discard: overwritten with what the Blueprint says",
          "items": {
            "minLength": 1,
            "type": "string",
          },
          "type": "array",
        },
        "discardAll": {
          "description": "Discard every change the compile lists (an entry in keep still stays)",
          "type": "boolean",
        },
        "keep": {
          "description": "Entries the compile listed as changed in the Editor to keep as the Editor left them (object:<id>, trigger:<id> …): each leaves the compile record, as Kept Content the Blueprint no longer writes",
          "items": {
            "minLength": 1,
            "type": "string",
          },
          "type": "array",
        },
        "keepAll": {
          "description": "Keep every change the compile lists (an entry in discard still goes)",
          "type": "boolean",
        },
        "mission": {
          "description": "The Mission's folder name in the Workspace's missions folder",
          "minLength": 1,
          "type": "string",
        },
        "outputDir": {
          "description": "Where to write the Map Package: a folder inside the Workspace, relative to its root, written whole. By default the Mission's committed package, <mission folder>/<Name>.SC2Map, compiled in place",
          "minLength": 1,
          "type": "string",
        },
        "refresh": {
          "description": "Close the map in the Editor first when the author has it open and its document has no unsaved changes, compile, then open it again, instead of refusing",
          "type": "boolean",
        },
        "workspace": {
          "description": "The Workspace this call is about, when it isn't the one the session is in: its folder, a git worktree of it, or any folder inside either (such as a Mission's), absolute. The nearest folder at or above it that holds the Workspace config serves, so a Mission that exists only in a worktree is read and written there, not in the main checkout. Without it the session's working folder serves (the MCP roots), else the Workspace the server started with",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "mission",
      ],
      "type": "object",
    },
    "name": "compile_map",
    "outputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "outputDir": {
          "type": "string",
        },
        "warnings": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
      },
      "required": [
