exports[`the tool list > is the same on a machine that can do everything, with both Doodad Finder tools 1`] = `
[
  {
    "annotations": {
      "destructiveHint": true,
      "readOnlyHint": false,
    },
    "description": "Adds a Doodad Use (a short, general phrase for what the author accepted a doodad as in a Doodad Search, such as "press head over a conveyor"; never a Mission's or a story's name), with the variation and scale that made it work and where it came from, a corrected look, or both, for a game doodad or a terrain object to the Workspace's doodad notes (doodad-notes.json beside its config), which search_doodads merges, and for a Campaign Mod doodad to its own entry in the mod's doodad index (its description's uses and look; refused while its entry has no description: run index_mod_doodads and describe it first). A use the doodad has already, case and spacing aside, takes the new variation and scale (and the source, when it has none); one core already holds with them is dropped. Drops any note core already holds, as from a released contribution. Gives the doodad's note as it now stands.",
    "execution": {
      "taskSupport": "forbidden",
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "from": {
