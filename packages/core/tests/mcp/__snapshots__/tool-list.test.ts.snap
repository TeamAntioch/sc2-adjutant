          "minLength": 1,
          "type": "string",
        },
        "setting": {
          "description": "One line on where the Mission is set; by default where it was imported from",
          "minLength": 1,
          "type": "string",
        },
        "source": {
          "description": "The unpacked .SC2Map folder to import: absolute, or relative to the Workspace root. Only read",
          "minLength": 1,
          "type": "string",
        },
        "title": {
          "description": "The Mission's title; by default the map's own name, or its file name while that is the Editor's default",
          "minLength": 1,
          "type": "string",
        },
        "workspace": {
          "description": "The Workspace this call is about, when it isn't the one the session is in: its folder, a git worktree of it, or any folder inside either (such as a Mission's), absolute. The nearest folder at or above it that holds the Workspace config serves, so a Mission that exists only in a worktree is read and written there, not in the main checkout. Without it the session's working folder serves (the MCP roots), else the Workspace the server started with",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "source",
        "mission",
      ],
      "type": "object",
    },
