  },
  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": true,
    },
    "description": "Finds cinematic sets (the pre-built locations Cutscene Editor files film in) that could play a place, from the Set Finder (served when the set-finder package, an optional dependency of core, is installed). Give the place wanted as the ask, such as "a cramped ship corridor with a cockpit at one end". Its sets are the published Set Finder's (Blizzard's, from @team-antioch/sc2-set-finder) with the Workspace's own (its cinematic-sets folder) and any public ones described since the release laid over them, where this machine has drawn them. It narrows them by keywords and a local embeddings model, then Jev grades each set's written look on four levels: 0 doesn't fit, 1 related but wrong, 2 could work with staging, 3 reads as exactly this. Results come best first, each with its id (as import_set takes it), its look, facets, what it could stand in for, the model pattern for each place where one set holds several, its source, size in cells, camera count and its chosen pictures as files to read (with the same view filmed in game where there is one); a published set this machine hasn't drawn gives its pictures' gallery addresses instead. The ranker judges the written look, never pictures, and a look is written from neutral-light renders that miss glass, glows and the game's lighting: read a candidate's pictures before choosing it. With rank false, or with no TypeSafe key, or past the server's spend cap, or when Jev fails, it gives the narrowing's order and says why. The first call loads the model, cards and vectors, which then stay loaded. Each ranked call sends the ask and the narrowed sets' looks to TypeSafe; no pictures or files. Reads only.",
    "execution": {
      "taskSupport": "forbidden",
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "ask": {
          "description": "The place wanted, in plain words",
          "minLength": 1,
          "type": "string",
        },
        "count": {
          "description": "At most this many results; 8 by default",
          "maximum": 24,
          "minimum": 1,
          "type": "integer",
        },
        "rank": {
          "description": "False gives the narrowing alone, with no call to the ranker; true by default",
          "type": "boolean",
        },
        "workspace": {
          "description": "The Workspace this call is about, when it isn't the one the session is in: its folder, a git worktree of it, or any folder inside either (such as a Mission's), absolute. The nearest folder at or above it that holds the Workspace config serves, so a Mission that exists only in a worktree is read and written there, not in the main checkout. Without it the session's working folder serves (the MCP roots), else the Workspace the server started with",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "ask",
      ],
      "type": "object",
    },
