{
  "name": "sc2-adjutant-site",
  "private": true,
  "version": "0.0.0",
  "description": "The sc2-adjutant site (adjutant.antioch.games): install, reference and tutorials, as a static Next.js export.",
  "type": "module",
  "scripts": {
    "reference": "node scripts/reference.ts",
    "dev": "pnpm run reference && next dev",
    "build": "pnpm run reference && next build && pagefind --site out",
    "serve": "node scripts/serve.mjs",
    "lint": "next typegen && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "5.2.7",
    "@fontsource/inter": "5.2.8",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@next/mdx": "16.4.5",
    "@team-antioch/sc2-adjutant": "^0.1.0",
    "next": "16.4.5",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@types/mdx": "2.0.13",
    "@types/node": "26.6.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "pagefind": "1.6.0",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
