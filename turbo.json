{
  "$schema": "https://turborepo.com/schema.json",
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "@team-antioch/sc2-adjutant#build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build", "@team-antioch/sc2-adjutant#build"]
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "cache": false
    }
  }
}
