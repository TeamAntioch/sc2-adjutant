{
  "name": "sc2-adjutant-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "The sc2-adjutant packages: core (engine, MCP server and CLIs) its first-party Plugins, and the site (site/), as npm workspaces.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "site"
  ],
  "scripts": {
    "build": "npm run build -w packages --if-present",
    "build:site": "npm run build -w site",
    "prepare": "npm run build",
    "test": "npm test --workspaces --if-present && npm run test:checks",
    "test:checks": "node scripts/check-plugin-imports.mjs && node scripts/check-catalog-moved.mjs && node scripts/check-packs.mjs",
    "check-packs": "npm run build && node scripts/check-packs.mjs",
    "link-catalog": "node scripts/link-catalog.mjs link",
    "unlink-catalog": "node scripts/link-catalog.mjs unlink",
    "test:watch": "npm run test:watch -w packages/core",
    "update-golden": "npm run update-golden --workspaces --if-present",
    "lint": "npm run build -w packages/core && npm run lint --workspaces --if-present && node scripts/check-plugin-imports.mjs && node scripts/check-catalog-moved.mjs",
    "generate-terrain": "npm run build && node packages/core/dist/cli/generate-terrain.js",
    "compile-map": "npm run build && node packages/core/dist/cli/compile-map.js",
    "import-map": "npm run build && node packages/core/dist/cli/import-map.js",
    "import-mod": "npm run build && node packages/core/dist/cli/import-mod.js",
    "compile-mod": "npm run build && node packages/core/dist/cli/compile-mod.js",
    "kept-report": "npm run build && node packages/core/dist/cli/kept-report.js",
    "propose-removals": "npm run build && node packages/core/dist/cli/propose-removals.js",
    "convert-assets": "npm run build && node packages/core/dist/cli/convert-assets.js",
    "convert-entries": "npm run build && node packages/core/dist/cli/convert-entries.js",
    "convert-files": "npm run build && node packages/core/dist/cli/convert-files.js",
    "convert-library": "npm run build && node packages/core/dist/cli/convert-library.js",
    "convert-screenplay": "npm run build && node packages/core/dist/cli/convert-screenplay.js",
    "convert-triggers": "npm run build && node packages/core/dist/cli/convert-triggers.js",
    "convert-sound-set": "npm run build && node packages/core/dist/cli/convert-sound-set.js",
    "sound-mix": "npm run build && node packages/core/dist/cli/sound-mix.js",
    "edit-kept": "npm run build && node packages/core/dist/cli/edit-kept.js",
    "survey": "npm run build && node packages/core/dist/cli/survey.js",
    "tune-kept": "npm run build && node packages/core/dist/cli/tune-kept.js",
    "edit-terrain": "npm run build && node packages/core/dist/cli/edit-terrain.js",
    "texture-usage": "npm run build && node packages/core/dist/cli/texture-usage.js",
    "texture-sheet": "npm run build && node packages/core/dist/cli/texture-sheet.js",
    "search-doodads": "npm run build && node packages/core/dist/cli/search-doodads.js",
    "doodad-finder": "npm run build && node packages/doodad-finder/dist/adjutant/cli.js",
    "set-finder": "npm run build && node packages/set-finder/dist/cli.js",
    "test-doodad-finder": "npm run build && node packages/doodad-finder/dist/cli/test-doodad-finder.js",
    "doodad-search-page": "npm run build && node packages/core/dist/cli/doodad-search-page.js",
    "catalog-sheets": "npm run build && node packages/core/scripts/catalog-sheets.mjs",
    "extract-catalog": "node packages/core/scripts/extract-catalog.mjs",
    "add-doodad-note": "npm run build && node packages/core/dist/cli/add-doodad-note.js",
    "contribute-doodad-notes": "npm run build && node packages/core/dist/cli/contribute-doodad-notes.js",
    "drift-test": "npm run build && node packages/core/dist/cli/drift-test.js",
    "compile-melee-map": "npm run build && node packages/core/dist/cli/compile-melee-map.js",
    "compile-cutscene": "npm run build && node packages/core/dist/cli/compile-cutscene.js",
    "model-anims": "npm run build && node packages/core/dist/cli/model-anims.js",
    "model-footprints": "npm run build && node packages/core/dist/cli/model-footprints.js",
    "display-channels": "npm run build && node packages/core/dist/cli/display-channels.js",
    "doodad-outlines": "npm run build && node packages/core/dist/cli/doodad-outlines.js",
    "lighting-preview": "npm run build && node packages/core/dist/cli/lighting-preview.js",
    "tts": "npm run build && node packages/core/dist/cli/tts-placeholders.js",
    "pull-screenplay": "npm run build && node packages/core/dist/cli/pull-screenplay.js",
    "edit-screenplay": "npm run build && node packages/core/dist/cli/edit-screenplay.js",
    "refresh-screenplay": "npm run build && node packages/core/dist/cli/refresh-screenplay.js",
    "preview": "npm run build && node packages/core/dist/cli/preview.js",
    "freeze-set-piece": "npm run build && node packages/core/dist/cli/freeze-set-piece.js",
    "capture-composite": "npm run build && node packages/core/dist/cli/capture-composite.js",
    "facing-strip": "npm run build && node packages/core/dist/cli/facing-strip.js",
    "effect-tour": "npm run build && node packages/core/dist/cli/effect-tour.js",
    "probe-game": "npm run build && node packages/core/dist/cli/probe-game.js",
    "compare-saves": "npm run build && node packages/core/dist/cli/compare-saves.js",
    "placement-stats": "npm run build && node packages/core/dist/cli/placement-stats.js",
    "cutscene-census": "npm run build && node packages/core/dist/cli/cutscene-census.js",
    "sync": "npm run build && node packages/core/dist/cli/sync.js",
    "catalog-sets": "npm run build && node packages/core/dist/cli/catalog-sets.js",
    "import-set": "npm run build && node packages/core/dist/cli/import-set.js",
    "contact-sheet": "npm run build && node packages/core/dist/cli/contact-sheet.js",
    "check-layout": "npm run build && node packages/core/dist/cli/check-layout.js",
    "check-workspace": "npm run build && node packages/core/dist/cli/check-workspace.js",
    "study": "npm run build && node packages/core/dist/cli/study.js",
    "sheet-readings": "npm run build && node packages/core/dist/cli/sheet-readings.js",
    "thumbnails": "npm run build && node packages/core/dist/cli/doodad-thumbnails.js",
    "index-mod-doodads": "npm run build && node packages/core/dist/cli/index-mod-doodads.js",
    "capture-exemplars": "npm run build && node packages/core/dist/cli/capture-exemplars.js",
    "render-set-views": "npm run build && node packages/core/dist/cli/render-set-views.js",
    "set-shots": "npm run build && node packages/core/dist/cli/set-shots.js",
    "set-cards": "npm run build && node packages/core/dist/cli/set-cards.js",
    "export-sets": "npm run build && node packages/core/dist/cli/export-sets.js",
    "game-cards": "npm run build && node packages/core/dist/cli/game-cards.js",
    "capture-sets": "npm run build && node packages/core/dist/cli/capture-sets.js",
    "capture-edit": "npm run build && node packages/core/dist/cli/capture-edit.js",
    "capture-shots": "npm run build && node packages/core/dist/cli/capture-shots.js"
  },
  "engines": {
    "node": ">=22.18"
  }
}
