{
  "name": "sc2-adjutant-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "The sc2-adjutant packages: core (engine, MCP server and CLIs) its first-party Plugins, and the site (site/), as pnpm workspaces.",
  "type": "module",
  "scripts": {
    "build": "node scripts/turbo.mjs run build --filter=./packages/* --output-logs=errors-only 1>&2",
    "build:site": "node scripts/turbo.mjs run build --filter=sc2-adjutant-site",
    "preinstall": "node scripts/only-pnpm.mjs",
    "prepare": "pnpm run build",
    "test": "node scripts/turbo.mjs run test --concurrency=1 && pnpm run test:checks",
    "test:checks": "node scripts/check-plugin-imports.mjs && node scripts/check-catalog-moved.mjs && node scripts/check-packs.mjs",
    "check-packs": "pnpm run build && node scripts/check-packs.mjs",
    "link-catalog": "node scripts/link-catalog.mjs link",
    "unlink-catalog": "node scripts/link-catalog.mjs unlink",
    "test:watch": "pnpm --filter @team-antioch/sc2-adjutant run test:watch",
    "update-golden": "pnpm -r --if-present run update-golden",
    "lint": "node scripts/turbo.mjs run lint && node scripts/check-plugin-imports.mjs && node scripts/check-catalog-moved.mjs",
    "generate-terrain": "pnpm run build && node packages/core/dist/cli/generate-terrain.js",
    "compile-map": "pnpm run build && node packages/core/dist/cli/compile-map.js",
    "import-map": "pnpm run build && node packages/core/dist/cli/import-map.js",
    "import-mod": "pnpm run build && node packages/core/dist/cli/import-mod.js",
    "compile-mod": "pnpm run build && node packages/core/dist/cli/compile-mod.js",
    "kept-report": "pnpm run build && node packages/core/dist/cli/kept-report.js",
    "propose-removals": "pnpm run build && node packages/core/dist/cli/propose-removals.js",
    "convert-assets": "pnpm run build && node packages/core/dist/cli/convert-assets.js",
    "convert-entries": "pnpm run build && node packages/core/dist/cli/convert-entries.js",
    "convert-files": "pnpm run build && node packages/core/dist/cli/convert-files.js",
    "convert-library": "pnpm run build && node packages/core/dist/cli/convert-library.js",
    "convert-screenplay": "pnpm run build && node packages/core/dist/cli/convert-screenplay.js",
    "convert-triggers": "pnpm run build && node packages/core/dist/cli/convert-triggers.js",
    "convert-sound-set": "pnpm run build && node packages/core/dist/cli/convert-sound-set.js",
    "sound-mix": "pnpm run build && node packages/core/dist/cli/sound-mix.js",
    "edit-kept": "pnpm run build && node packages/core/dist/cli/edit-kept.js",
    "survey": "pnpm run build && node packages/core/dist/cli/survey.js",
    "tune-kept": "pnpm run build && node packages/core/dist/cli/tune-kept.js",
    "edit-terrain": "pnpm run build && node packages/core/dist/cli/edit-terrain.js",
    "texture-usage": "pnpm run build && node packages/core/dist/cli/texture-usage.js",
    "paint-region": "pnpm run build && node packages/core/dist/cli/paint-region.js",
    "texture-sheet": "pnpm run build && node packages/core/dist/cli/texture-sheet.js",
    "search-doodads": "pnpm run build && node packages/core/dist/cli/search-doodads.js",
    "doodad-finder": "pnpm run build && node packages/doodad-finder/dist/adjutant/cli.js",
    "set-finder": "pnpm run build && node packages/set-finder/dist/cli.js",
    "test-doodad-finder": "pnpm run build && node packages/doodad-finder/dist/cli/test-doodad-finder.js",
    "doodad-search-page": "pnpm run build && node packages/core/dist/cli/doodad-search-page.js",
    "catalog-sheets": "pnpm run build && node packages/core/scripts/catalog-sheets.mjs",
    "extract-catalog": "node packages/core/scripts/extract-catalog.mjs",
    "add-doodad-note": "pnpm run build && node packages/core/dist/cli/add-doodad-note.js",
    "contribute-doodad-notes": "pnpm run build && node packages/core/dist/cli/contribute-doodad-notes.js",
    "drift-test": "pnpm run build && node packages/core/dist/cli/drift-test.js",
    "compile-melee-map": "pnpm run build && node packages/core/dist/cli/compile-melee-map.js",
    "compile-cutscene": "pnpm run build && node packages/core/dist/cli/compile-cutscene.js",
    "model-anims": "pnpm run build && node packages/core/dist/cli/model-anims.js",
    "model-footprints": "pnpm run build && node packages/core/dist/cli/model-footprints.js",
    "display-channels": "pnpm run build && node packages/core/dist/cli/display-channels.js",
    "doodad-outlines": "pnpm run build && node packages/core/dist/cli/doodad-outlines.js",
    "lighting-preview": "pnpm run build && node packages/core/dist/cli/lighting-preview.js",
    "tts": "pnpm run build && node packages/core/dist/cli/tts-placeholders.js",
    "pull-screenplay": "pnpm run build && node packages/core/dist/cli/pull-screenplay.js",
    "edit-screenplay": "pnpm run build && node packages/core/dist/cli/edit-screenplay.js",
    "refresh-screenplay": "pnpm run build && node packages/core/dist/cli/refresh-screenplay.js",
    "preview": "pnpm run build && node packages/core/dist/cli/preview.js",
    "freeze-set-piece": "pnpm run build && node packages/core/dist/cli/freeze-set-piece.js",
    "capture-composite": "pnpm run build && node packages/core/dist/cli/capture-composite.js",
    "facing-strip": "pnpm run build && node packages/core/dist/cli/facing-strip.js",
    "effect-tour": "pnpm run build && node packages/core/dist/cli/effect-tour.js",
    "probe-game": "pnpm run build && node packages/core/dist/cli/probe-game.js",
    "compare-saves": "pnpm run build && node packages/core/dist/cli/compare-saves.js",
    "placement-stats": "pnpm run build && node packages/core/dist/cli/placement-stats.js",
    "cutscene-census": "pnpm run build && node packages/core/dist/cli/cutscene-census.js",
    "sync": "pnpm run build && node packages/core/dist/cli/sync.js",
    "catalog-sets": "pnpm run build && node packages/core/dist/cli/catalog-sets.js",
    "import-set": "pnpm run build && node packages/core/dist/cli/import-set.js",
    "contact-sheet": "pnpm run build && node packages/core/dist/cli/contact-sheet.js",
    "check-layout": "pnpm run build && node packages/core/dist/cli/check-layout.js",
    "check-workspace": "pnpm run build && node packages/core/dist/cli/check-workspace.js",
    "study": "pnpm run build && node packages/core/dist/cli/study.js",
    "sheet-readings": "pnpm run build && node packages/core/dist/cli/sheet-readings.js",
    "thumbnails": "pnpm run build && node packages/core/dist/cli/doodad-thumbnails.js",
    "index-mod-doodads": "pnpm run build && node packages/core/dist/cli/index-mod-doodads.js",
    "capture-exemplars": "pnpm run build && node packages/core/dist/cli/capture-exemplars.js",
    "render-set-views": "pnpm run build && node packages/core/dist/cli/render-set-views.js",
    "set-shots": "pnpm run build && node packages/core/dist/cli/set-shots.js",
    "set-cards": "pnpm run build && node packages/core/dist/cli/set-cards.js",
    "export-sets": "pnpm run build && node packages/core/dist/cli/export-sets.js",
    "game-cards": "pnpm run build && node packages/core/dist/cli/game-cards.js",
    "capture-sets": "pnpm run build && node packages/core/dist/cli/capture-sets.js",
    "capture-edit": "pnpm run build && node packages/core/dist/cli/capture-edit.js",
    "capture-shots": "pnpm run build && node packages/core/dist/cli/capture-shots.js",
    "shots-for-zones": "pnpm run build && node packages/core/dist/cli/shots-for-zones.js",
    "still-review": "pnpm run build && node packages/core/dist/cli/still-review.js",
    "turbo": "node scripts/turbo.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "turbo": "2.11.13"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.16.1",
      "onFail": "ignore"
    }
  },
  "packageManager": "pnpm@12.16.1"
}
